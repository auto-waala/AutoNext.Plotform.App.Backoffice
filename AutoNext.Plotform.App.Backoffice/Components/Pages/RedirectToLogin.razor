@using AutoNext.Plotform.App.Backoffice.Integrations.AccessControl
@inject NavigationManager Navigation
@inject AuthStateProvider AuthStateProvider

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Ensure circuit is initialized before redirecting
            await AuthStateProvider.InitializeCircuitAsync();

            // After init, check if still unauthorized (not just prerender anonymous)
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated != true)
            {
                var returnUrl = Uri.EscapeDataString(Navigation.Uri);
                Navigation.NavigateTo($"/login?returnUrl={returnUrl}", true);
            }
        }
    }
}
@page "/inspectionchecklists"
@inherits InspectionChecklistBase
@using BlazorBootstrap

<div class="container-fluid" style="padding-left: 0px; padding-right: 0px;">
    <div class="row" style="padding-left: 0px; padding-right: 0px;">
        <div class="col">
            <div class="card inspection-checklist-card">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex justify-content-between align-items-center py-1">
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <h5 class="mb-0">
                                <i class="bi bi-clipboard-check text-primary me-2"></i>Inspection Checklists
                            </h5>
                            <span class="badge bg-light text-dark ms-2">
                                <span class="text-primary fw-bold">@TotalCount</span> checklists
                            </span>
                            @if (SelectedChecklists.Any())
                            {
                                <span class="badge bg-primary ms-1">@SelectedChecklists.Count selected</span>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (SelectedChecklists.Any())
                            {
                                <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1"
                                        @onclick="BulkDelete">
                                    <i class="bi bi-trash"></i>
                                    <span class="d-none d-sm-inline">Delete (@SelectedChecklists.Count)</span>
                                </button>
                            }
                            <button class="btn btn-sm btn-primary d-flex align-items-center gap-1"
                                    @onclick="OpenAddChecklistSidebar">
                                <i class="bi bi-plus-circle"></i>
                                <span class="d-none d-sm-inline">New Checklist</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Filter Bar -->
                <div class="card-body border-bottom bg-light">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Search</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Name or code..."
                                       @bind="SearchTerm" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">Category</label>
                            <select class="form-select form-select-sm" @bind="CategoryFilter">
                                <option value="">All Categories</option>
                                @foreach (var category in AvailableCategories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">Critical</label>
                            <select class="form-select form-select-sm" @bind="CriticalFilter">
                                <option value="">All</option>
                                <option value="true">Critical</option>
                                <option value="false">Non-Critical</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">Weightage</label>
                            <select class="form-select form-select-sm" @bind="WeightageFilter">
                                <option value="">All</option>
                                <option value="1">1 (Low)</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                                <option value="6">6</option>
                                <option value="7">7</option>
                                <option value="8">8</option>
                                <option value="9">9</option>
                                <option value="10">10 (High)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">Status</label>
                            <select class="form-select form-select-sm" @bind="ActiveFilter">
                                <option value="">All</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="ClearFilters">
                                <i class="bi bi-eraser"></i> Clear
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-0">
                    @if (IsLoading)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="text-muted mt-3 small">Loading checklists...</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover inspection-table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px">
                                            <input type="checkbox"
                                                   checked="@AllPageSelected"
                                                   @onchange="_ => ToggleAllSelection()" />
                                        </th>
                                        <th>Name</th>
                                        <th>Code</th>
                                        <th>Category</th>
                                        <th class="text-center">Critical</th>
                                        <th class="text-center">Weightage</th>
                                        <th>Vehicle Types</th>
                                        <th class="text-center">Order</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th style="width: 140px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (PaginatedChecklists.Any())
                                    {
                                        @foreach (var checklist in PaginatedChecklists)
                                        {
                                            var localChecklist = checklist;
                                            <tr>
                                                <td>
                                                    <input type="checkbox"
                                                           checked="@SelectedChecklists.Contains(localChecklist)"
                                                           @onchange="e => OnChecklistSelectionChanged(localChecklist, (bool)e.Value!)" />
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="checklist-avatar" style="background: @GetCriticalColor(localChecklist.IsCritical)">
                                                            <i class="bi @(localChecklist.IsCritical ? "bi-exclamation-triangle" : "bi-clipboard-check")"></i>
                                                        </div>
                                                        <div>
                                                            <strong>@localChecklist.Name</strong>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <code class="small">@localChecklist.Code</code>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(localChecklist.Category))
                                                    {
                                                        <span class="badge bg-secondary">@localChecklist.Category</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (localChecklist.IsCritical)
                                                    {
                                                        <i class="bi bi-exclamation-triangle-fill text-danger" title="Critical"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-info-circle-fill text-secondary" title="Non-Critical"></i>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge @GetWeightageBadgeClass(localChecklist.Weightage)">
                                                        @localChecklist.Weightage
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (localChecklist.ApplicableVehicleTypes?.Any() == true)
                                                    {
                                                        <div class="vehicle-types-badge">
                                                            @foreach (var type in localChecklist.ApplicableVehicleTypes.Take(2))
                                                            {
                                                                <span class="badge bg-light text-dark me-1">@type</span>
                                                            }
                                                            @if (localChecklist.ApplicableVehicleTypes.Count > 2)
                                                            {
                                                                <span class="badge bg-light text-dark">+@(localChecklist.ApplicableVehicleTypes.Count - 2)</span>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">All</span>
                                                    }
                                                </td>
                                                <td class="text-center">@localChecklist.DisplayOrder</td>
                                                <td>
                                                    <span class="badge @GetStatusBadgeClass(localChecklist.IsActive)">
                                                        @GetStatusText(localChecklist.IsActive)
                                                    </span>
                                                </td>
                                                <td>
                                                    @localChecklist.CreatedAt.ToString("yyyy-MM-dd")
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <button class="btn btn-outline-primary"
                                                                @onclick="() => OpenEditChecklistSidebar(localChecklist)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-outline-warning"
                                                                @onclick="() => ToggleStatus(localChecklist)">
                                                            <i class="bi @(localChecklist.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger"
                                                                @onclick="() => DeleteChecklist(localChecklist)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="11" class="text-center py-5 text-muted">
                                                @if (HasActiveFilters)
                                                {
                                                    <div>
                                                        <i class="bi bi-filter-circle fs-1"></i>
                                                        <p class="mt-2">No checklists match your filters</p>
                                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ClearFilters">
                                                            Clear Filters
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div>
                                                        <i class="bi bi-clipboard-x fs-1"></i>
                                                        <p class="mt-2">No inspection checklists found</p>
                                                        <button class="btn btn-sm btn-primary mt-2" @onclick="OpenAddChecklistSidebar">
                                                            <i class="bi bi-plus-circle"></i> Add First Checklist
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (TotalPages > 1)
                        {
                            <div class="pagination-container p-3 border-top">
                                <nav>
                                    <ul class="pagination justify-content-center mb-0">
                                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">
                                                Previous
                                            </button>
                                        </li>

                                        @for (int i = 1; i <= TotalPages; i++)
                                        {
                                            var pageNum = i;
                                            if (pageNum == 1 || pageNum == TotalPages || (pageNum >= CurrentPage - 2 && pageNum <= CurrentPage + 2))
                                            {
                                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                                    <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                                                </li>
                                            }
                                            else if (pageNum == CurrentPage - 3 || pageNum == CurrentPage + 3)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                        }

                                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">
                                                Next
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                </div>

                @if (!IsLoading && AllChecklists.Any())
                {
                    <div class="card-footer bg-white border-top">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex gap-3 flex-wrap">
                                <small class="text-muted">
                                    <span class="fw-medium">@TotalCount</span> total
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-check-circle-fill text-success me-1"></i>
                                    <span class="fw-medium">@ActiveCount</span> active
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>
                                    <span class="fw-medium">@CriticalCount</span> critical
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-star-fill text-warning me-1"></i>
                                    <span class="fw-medium">Avg Weightage: @AverageWeightage</span>
                                </small>
                                <small class="text-muted">
                                    Showing @(((CurrentPage - 1) * ItemsPerPage) + 1) to
                                    @(Math.Min(CurrentPage * ItemsPerPage, TotalCount)) of @TotalCount entries
                                </small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <small class="text-muted">Show:</small>
                                <select class="form-select form-select-sm page-size-select" @onchange="OnPageSizeChanged">
                                    @foreach (var size in PageSizeOptions)
                                    {
                                        <option value="@size" selected="@(size == ItemsPerPage)">@size</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Sidebar Component -->
<InspectionChecklistSidebar @bind-IsVisible="@showSidebar" 
                           ChecklistToEdit="@selectedChecklist" 
                           OnSave="@OnChecklistSave" />

<style>
    .checklist-avatar {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 14px;
    }
    
    .inspection-table tbody tr:hover {
        background-color: rgba(102, 126, 234, 0.05);
        cursor: pointer;
    }
    
    .vehicle-types-badge {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }
    
    .page-size-select {
        width: auto;
        min-width: 70px;
    }
</style>
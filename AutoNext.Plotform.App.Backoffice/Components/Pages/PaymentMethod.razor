@page "/payment-methods"
@inherits PaymentMethodBase
@using BlazorBootstrap

<div class="container-fluid" style="padding-left: 0px; padding-right: 0px;">
    <div class="row" style="padding-left: 0px; padding-right: 0px;">
        <div class="col">
            <div class="card payment-method-card">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex justify-content-between align-items-center py-1">
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <h5 class="mb-0">
                                <i class="bi bi-credit-card text-primary me-2"></i>Payment Methods
                            </h5>
                            <span class="badge bg-light text-dark ms-2">
                                <span class="text-primary fw-bold">@TotalCount</span> methods
                            </span>
                            @if (SelectedPaymentMethods.Any())
                            {
                                <span class="badge bg-primary ms-1">@SelectedPaymentMethods.Count selected</span>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (SelectedPaymentMethods.Any())
                            {
                                <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1"
                                        @onclick="BulkDelete">
                                    <i class="bi bi-trash"></i>
                                    <span class="d-none d-sm-inline">Delete (@SelectedPaymentMethods.Count)</span>
                                </button>
                            }
                            <button class="btn btn-sm btn-primary d-flex align-items-center gap-1"
                                    @onclick="OpenAddPaymentMethodSidebar">
                                <i class="bi bi-plus-circle"></i>
                                <span class="d-none d-sm-inline">New Payment Method</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Filter Bar -->
                <div class="card-body border-bottom bg-light">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Search</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Name or code..."
                                       @bind="SearchTerm" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">Type</label>
                            <select class="form-select form-select-sm" @bind="TypeFilter">
                                <option value="">All Types</option>
                                @foreach (var type in AvailableTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">Availability</label>
                            <select class="form-select form-select-sm" @bind="AvailabilityFilter">
                                <option value="">All</option>
                                <option value="sellers">For Sellers</option>
                                <option value="buyers">For Buyers</option>
                                <option value="instant">Instant</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">Status</label>
                            <select class="form-select form-select-sm" @bind="ActiveFilter">
                                <option value="">All</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="ClearFilters">
                                <i class="bi bi-eraser"></i> Clear
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-0">
                    @if (IsLoading)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="text-muted mt-3 small">Loading payment methods...</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover payment-method-table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px">
                                            <input type="checkbox"
                                                   checked="@AllPageSelected"
                                                   @onchange="_ => ToggleAllSelection()" />
                                        </th>
                                        <th>Name</th>
                                        <th>Code</th>
                                        <th>Type</th>
                                        <th class="text-center">Fee %</th>
                                        <th class="text-center">Fixed Fee</th>
                                        <th class="text-center">Settlement</th>
                                        <th class="text-center">Instant</th>
                                        <th class="text-center">Sellers</th>
                                        <th class="text-center">Buyers</th>
                                        <th class="text-center">Order</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th style="width: 120px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (PaginatedPaymentMethods.Any())
                                    {
                                        @foreach (var method in PaginatedPaymentMethods)
                                        {
                                            var localMethod = method;
                                            <tr>
                                                <td>
                                                    <input type="checkbox"
                                                           checked="@SelectedPaymentMethods.Contains(localMethod)"
                                                           @onchange="e => OnPaymentMethodSelectionChanged(localMethod, (bool)e.Value!)" />
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="payment-avatar">
                                                            @if (!string.IsNullOrEmpty(localMethod.IconUrl))
                                                            {
                                                                <img src="@localMethod.IconUrl" alt="@localMethod.Name" style="width:20px;height:20px;object-fit:contain;" />
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-credit-card"></i>
                                                            }
                                                        </div>
                                                        <strong>@localMethod.Name</strong>
                                                    </div>
                                                </td>
                                                <td><code class="small">@localMethod.Code</code></td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(localMethod.Type))
                                                    {
                                                        <span class="badge bg-secondary">@localMethod.Type</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge @GetFeeBadgeClass(localMethod.ProcessingFeePercentage)">
                                                        @localMethod.ProcessingFeePercentage.ToString("F2")%
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    @if (localMethod.ProcessingFeeFixed > 0)
                                                    {
                                                        <span class="small">₹@localMethod.ProcessingFeeFixed.ToString("F2")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (localMethod.SettlementDays.HasValue)
                                                    {
                                                        <span class="small">@localMethod.SettlementDays D</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <i class="bi @(localMethod.IsInstant ? "bi-lightning-fill text-warning" : "bi-dash text-muted")"></i>
                                                </td>
                                                <td class="text-center">
                                                    <i class="bi @(localMethod.IsAvailableForSellers ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                                                </td>
                                                <td class="text-center">
                                                    <i class="bi @(localMethod.IsAvailableForBuyers ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                                                </td>
                                                <td class="text-center">@localMethod.DisplayOrder</td>
                                                <td>
                                                    <span class="badge @GetStatusBadgeClass(localMethod.IsActive)">
                                                        @GetStatusText(localMethod.IsActive)
                                                    </span>
                                                </td>
                                                <td>@localMethod.CreatedAt.ToString("yyyy-MM-dd")</td>
                                                <td>
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <button class="btn btn-outline-primary"
                                                                @onclick="() => OpenEditPaymentMethodSidebar(localMethod)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-outline-warning"
                                                                @onclick="() => ToggleStatus(localMethod)">
                                                            <i class="bi @(localMethod.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger"
                                                                @onclick="() => DeletePaymentMethod(localMethod)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="14" class="text-center py-5 text-muted">
                                                @if (HasActiveFilters)
                                                {
                                                    <div>
                                                        <i class="bi bi-filter-circle fs-1"></i>
                                                        <p class="mt-2">No payment methods match your filters</p>
                                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ClearFilters">
                                                            Clear Filters
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div>
                                                        <i class="bi bi-credit-card fs-1"></i>
                                                        <p class="mt-2">No payment methods found</p>
                                                        <button class="btn btn-sm btn-primary mt-2" @onclick="OpenAddPaymentMethodSidebar">
                                                            <i class="bi bi-plus-circle"></i> Add First Payment Method
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (TotalPages > 1)
                        {
                            <div class="pagination-container p-3 border-top">
                                <nav>
                                    <ul class="pagination justify-content-center mb-0">
                                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">Previous</button>
                                        </li>
                                        @for (int i = 1; i <= TotalPages; i++)
                                        {
                                            var pageNum = i;
                                            if (pageNum == 1 || pageNum == TotalPages || (pageNum >= CurrentPage - 2 && pageNum <= CurrentPage + 2))
                                            {
                                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                                    <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                                                </li>
                                            }
                                            else if (pageNum == CurrentPage - 3 || pageNum == CurrentPage + 3)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                        }
                                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">Next</button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                </div>

                @if (!IsLoading && AllPaymentMethods.Any())
                {
                    <div class="card-footer bg-white border-top">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex gap-3 flex-wrap">
                                <small class="text-muted">
                                    <span class="fw-medium">@TotalCount</span> total
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-check-circle-fill text-success me-1"></i>
                                    <span class="fw-medium">@ActiveCount</span> active
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-lightning-fill text-warning me-1"></i>
                                    <span class="fw-medium">@InstantCount</span> instant
                                </small>
                                <small class="text-muted">
                                    Showing @(((CurrentPage - 1) * ItemsPerPage) + 1) to
                                    @(Math.Min(CurrentPage * ItemsPerPage, TotalCount)) of @TotalCount entries
                                </small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <small class="text-muted">Show:</small>
                                <select class="form-select form-select-sm page-size-select" @onchange="OnPageSizeChanged">
                                    @foreach (var size in PageSizeOptions)
                                    {
                                        <option value="@size" selected="@(size == ItemsPerPage)">@size</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Sidebar Component -->
<PaymentMethodSidebar @bind-IsVisible="@showSidebar"
                      PaymentMethodToEdit="@selectedPaymentMethod"
                      OnSave="@OnPaymentMethodSave" />

<style>
    .payment-avatar {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 14px;
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
    }

    .payment-method-table tbody tr:hover {
        background-color: rgba(17, 153, 142, 0.05);
        cursor: pointer;
    }

    .page-size-select {
        width: auto;
        min-width: 70px;
    }
</style>
                                    <label class="form-label small fw-medium">Full Address</label>
                                    <textarea class="form-control" rows="2" @bind="EditModel.Location.FullAddress"></textarea>
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(SellerSection)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(SellerSection)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Seller Name</small>
                                    <span class="fw-medium">@Vehicle.Seller?.Name</span>
                                </div>

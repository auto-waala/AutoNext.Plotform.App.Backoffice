                                        <small class="text-muted d-block mb-2">Highlight</small>
                                        <div class="alert alert-info py-2 mb-0 small">@Vehicle.Highlight</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Section 12: Test Drive -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-steering-wheel me-2"></i>Test Drive
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleSectionEdit(TestDriveSection)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (EditingSections.Contains(TestDriveSection))
                        {
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="EditModel.TestDrive.Available" />
                                        <label class="form-check-label small fw-medium">Test Drive Available</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Booking Amount (₹)</label>
                                    <input type="number" class="form-control" @bind="EditModel.TestDrive.BookingAmount" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Booking URL</label>
                                    <input type="text" class="form-control" @bind="EditModel.TestDrive.BookingUrl" />
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(TestDriveSection)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(TestDriveSection)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                @if (Vehicle.TestDrive?.Available == true)
                                {
                                    <div>
                                        <span class="badge bg-success mb-2">Available</span>
                                        @if (Vehicle.TestDrive.BookingAmount > 0)
                                        {
                                            <div class="small text-muted mt-1">Booking Amount: @FormatPrice(Vehicle.TestDrive.BookingAmount)</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">Test drive not available</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Video Player Modal -->
@if (ShowVideoModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.95)" @onclick="CloseVideoModal">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body p-0">
                    <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3"
                            style="width: 40px; height: 40px; z-index: 1060; background: white; border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.3);"
                            @onclick="CloseVideoModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <div class="ratio ratio-16x9">
                        <iframe id="videoPlayer"
                                src="@GetYouTubeEmbedUrl(SelectedVideoUrl)"
                                title="YouTube video player"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen
                                sandbox="allow-same-origin allow-scripts allow-popups allow-forms allow-presentation">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Shorts Player Modal -->
@if (ShowShortModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.95)" @onclick="CloseShortModal">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body p-0">
                    <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3"
                            style="width: 40px; height: 40px; z-index: 1060; background: white; border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.3);"
                            @onclick="CloseShortModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <div style="position: relative; padding-bottom: 177.77%; height: 0; overflow: hidden; border-radius: 12px;">
                        <iframe id="shortsPlayer"
                                src="@GetYouTubeEmbedUrl(SelectedShortUrl)"
                                title="YouTube Shorts player"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen
                                sandbox="allow-same-origin allow-scripts allow-popups allow-forms allow-presentation"
                                style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Save Confirmation Modal -->
@if (ShowSaveConfirmation)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Save Changes</h5>
                    <button type="button" class="btn-close" @onclick="CloseSaveConfirmation"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to save all changes?</p>
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        Sections with changes: <strong>@string.Join(", ", ChangedSections)</strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseSaveConfirmation">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="ConfirmSaveAll" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-save me-1"></i>Save All
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .form-control, .form-select {
        font-size: 0.875rem;
    }

    .btn-sm {
        font-size: 0.8125rem;
    }

    .card-header {
        background-color: #fff;
    }

    .badge {
        font-weight: 500;
    }
    
    .modal.fade.show {
        background-color: rgba(0,0,0,0.5);
    }
    
    .ratio-16x9 {
        aspect-ratio: 16/9;
    }
</style>
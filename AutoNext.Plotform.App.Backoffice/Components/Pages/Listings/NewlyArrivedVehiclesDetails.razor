@page "/newly-arrived-vehicles/{VehicleId}/edit"
@inherits NewlyArrivedVehiclesDetailsBase

<div class="container-fluid px-0">
    @if (IsLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-3 small">Loading vehicle details...</p>
        </div>
    }
    else if (Vehicle == null)
    {
        <div class="text-center py-5">
            <i class="bi bi-car-front-fill fs-1 text-muted"></i>
            <h5 class="mt-3">Vehicle not found</h5>
            <button class="btn btn-primary mt-2" @onclick="GoBack">Back to List</button>
        </div>
    }
    else
    {
        <!-- Page Header with Global Save -->
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h4 class="mb-1 fw-bold">
                            <i class="bi bi-pencil-square text-primary me-2"></i>
                            Edit Newly Arrived Vehicle
                        </h4>
                        <p class="text-muted small mb-0">
                            @Vehicle.BrandName @Vehicle.ModelName • Arrived: @Vehicle.ArrivalDate.ToString("dd MMM yyyy")
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary" @onclick="GoBack">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </button>
                        <button class="btn btn-primary" @onclick="SaveAllChanges" disabled="@(!HasChanges)">
                            <i class="bi bi-save me-1"></i>Save All Changes
                            @if (HasChanges)
                            {
                                <span class="badge bg-light text-primary ms-2">@ChangedSections.Count</span>
                            }
                        </button>
                    </div>
                </div>
                @if (HasChanges)
                {
                    <div class="alert alert-info mt-3 mb-0 py-2 small">
                        <i class="bi bi-info-circle me-1"></i>
                        You have unsaved changes in <strong>@string.Join(", ", ChangedSections)</strong>
                    </div>
                }
            </div>
        </div>

        <!-- Main Content with Edit Sections -->
        <div class="row g-4">
            <!-- LEFT COLUMN -->
            <div class="col-lg-6">

                <!-- Section 1: Basic Information -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-info-circle me-2"></i>Basic Information
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleSectionEdit(BasicSection)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (EditingSections.Contains(BasicSection))
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Brand Name</label>
                                    <input type="text" class="form-control" @bind="EditModel.BrandName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Model Name</label>
                                    <input type="text" class="form-control" @bind="EditModel.ModelName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Vehicle Type</label>
                                    <input type="text" class="form-control" @bind="EditModel.VehicleType" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Body Type</label>
                                    <input type="text" class="form-control" @bind="EditModel.BodyType" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-medium">Page Title</label>
                                    <input type="text" class="form-control" @bind="EditModel.PageTitle" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-medium">Description</label>
                                    <textarea class="form-control" rows="3" @bind="EditModel.DescriptionText"></textarea>
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(BasicSection)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(BasicSection)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Brand Name</small>
                                    <span class="fw-medium">@Vehicle.BrandName</span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Model Name</small>
                                    <span class="fw-medium">@Vehicle.ModelName</span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Vehicle Type</small>
                                    <span>@Vehicle.VehicleType</span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Body Type</small>
                                    <span>@Vehicle.BodyType</span>
                                </div>
                                <div class="col-12 mb-2">
                                    <small class="text-muted d-block">Page Title</small>
                                    <span>@Vehicle.PageTitle</span>
                                </div>
                                <div class="col-12 mb-2">
                                    <small class="text-muted d-block">Description</small>
                                    <p class="small mb-0">@(Vehicle.DescriptionText?.Length > 100 ? Vehicle.DescriptionText.Substring(0, 100) + "..." : Vehicle.DescriptionText)</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Section 2: Pricing & EMI -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-currency-rupee me-2"></i>Pricing & EMI
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleSectionEdit(PricingSection)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (EditingSections.Contains(PricingSection))
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Min Price (₹)</label>
                                    <input type="number" class="form-control" @bind="EditModel.MinPrice" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Max Price (₹)</label>
                                    <input type="number" class="form-control" @bind="EditModel.MaxPrice" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">EMI Amount (₹)</label>
                                    <input type="number" class="form-control" @bind="EditModel.Emi.Emi" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">EMI Months</label>
                                    <input type="number" class="form-control" @bind="EditModel.Emi.Months" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Interest Rate (%)</label>
                                    <input type="number" step="0.1" class="form-control" @bind="EditModel.Emi.InterestRate" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">EMI Display Text</label>
                                    <input type="text" class="form-control" @bind="EditModel.Emi.DisplayText" />
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(PricingSection)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(PricingSection)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Min Price</small>
                                    <span class="fw-bold text-primary">@FormatPrice(Vehicle.MinPrice)</span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Max Price</small>
                                    <span class="fw-bold">@FormatPrice(Vehicle.MaxPrice)</span>
                                </div>
                                @if (Vehicle.Emi != null && Vehicle.Emi.Emi > 0)
                                {
                                    <div class="col-md-6 mb-2">
                                        <small class="text-muted d-block">EMI</small>
                                        <span class="text-success">₹@Vehicle.Emi.Emi.ToString("N0")/mo</span>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <small class="text-muted d-block">Tenure</small>
                                        <span>@Vehicle.Emi.Months months</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Section 3: Images -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-images me-2"></i>Images
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleSectionEdit(ImagesSection)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (EditingSections.Contains(ImagesSection))
                        {
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label small fw-medium">Upload New Images</label>
                                    <InputFile OnChange="@HandleImageFilesSelected" multiple accept="image/*" class="form-control" />
                                    @if (SelectedImageFiles.Any())
                                    {
                                        <div class="mt-2">
                                            <div class="alert alert-info small">
                                                <strong>@SelectedImageFiles.Count</strong> file(s) selected
                                            </div>
                                            <button class="btn btn-sm btn-primary" @onclick="UploadImages" disabled="@IsUploadingImages">
                                                @if (IsUploadingImages)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                }
                                                <i class="bi bi-cloud-upload me-1"></i>Upload Images
                                            </button>
                                            @if (!string.IsNullOrEmpty(ImageUploadProgress))
                                            {
                                                <span class="ms-2 small text-muted">@ImageUploadProgress</span>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="col-12">
                                    <label class="form-label small fw-bold">Current Images (@EditModel.Images.Count)</label>
                                    <div class="row g-2">
                                        @for (int i = 0; i < EditModel.Images.Count; i++)
                                        {
                                            var index = i;
                                            var image = EditModel.Images[index];
                                            <div class="col-md-3">
                                                <div class="position-relative">
                                                    <img src="@image.FileUrl" alt="Vehicle Image"
                                                         class="img-fluid rounded border"
                                                         style="height: 100px; width: 100%; object-fit: cover;" />
                                                    <div class="position-absolute top-0 end-0 m-1">
                                                        <button class="btn btn-sm btn-danger rounded-circle"
                                                                style="width: 24px; height: 24px; padding: 0;"
                                                                @onclick="() => RemoveImage(index)">
                                                            <i class="bi bi-x small"></i>
                                                        </button>
                                                    </div>
                                                    @if (image.IsPrimary)
                                                    {
                                                        <div class="position-absolute bottom-0 start-0 m-1">
                                                            <span class="badge bg-primary">Primary</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-outline-secondary position-absolute bottom-0 start-0 m-1"
                                                                style="font-size: 10px; padding: 2px 4px;"
                                                                @onclick="() => SetPrimaryImage(index)">
                                                            Set Primary
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    @if (!EditModel.Images.Any())
                                    {
                                        <p class="text-muted small text-center py-3">No images uploaded yet</p>
                                    }
                                </div>

                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(ImagesSection)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(ImagesSection)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (Vehicle.Images != null)
                                    {
                                        @foreach (var image in Vehicle.Images.Take(6))
                                        {
                                            <img src="@image.FileUrl" alt="Vehicle Image"
                                                 class="rounded border"
                                                 style="width: 80px; height: 80px; object-fit: cover;" />
                                        }
                                        @if (Vehicle.Images.Count > 6)
                                        {
                                            <div class="d-flex align-items-center">
                                                <span class="badge bg-secondary">+@(Vehicle.Images.Count - 6)</span>
                                            </div>
                                        }
                                    }
                                </div>
                                @if ((Vehicle.Images?.Count ?? 0) == 0)
                                {
                                    <p class="text-muted small mb-0">No images uploaded</p>
                                }
                                else
                                {
                                    <div class="mt-2">
                                        <small class="text-muted">@(Vehicle.Images?.Count ?? 0) image(s)</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Section 4: Videos / Shorts -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-play-circle me-2"></i>Videos
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleSectionEdit(VideosSection)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (EditingSections.Contains(VideosSection))
                        {
                            <div class="row g-3">
                                <div class="col-12">
                                    @if (!IsAddingVideo)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => { IsAddingVideo = true; StateHasChanged(); }">
                                            <i class="bi bi-plus-circle me-1"></i>Add Video
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="border rounded p-3">
                                            <div class="mb-2">
                                                <label class="form-label small fw-medium">YouTube URL</label>
                                                <input type="text" class="form-control" @bind="NewVideo.FileUrl"
                                                       @oninput="e => OnVideoUrlChanged(e.Value?.ToString() ?? string.Empty)" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small fw-medium">Duration (optional)</label>
                                                <input type="text" class="form-control" @bind="NewVideo.Duration" placeholder="e.g., 2:30" />
                                            </div>
                                            @if (!string.IsNullOrEmpty(NewVideo.ThumbnailUrl))
                                            {
                                                <div class="mb-2">
                                                    <img src="@NewVideo.ThumbnailUrl" alt="Thumbnail" style="height: 60px;" class="rounded" />
                                                </div>
                                            }
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-success" @onclick="AddVideo">
                                                    <i class="bi bi-check me-1"></i>Add
                                                </button>
                                                <button class="btn btn-sm btn-secondary" @onclick="CancelVideo">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="col-12">
                                    <label class="form-label small fw-bold">Current Videos (@EditModel.Videos.Count)</label>
                                    <div class="row g-3">
                                        @for (int i = 0; i < EditModel.Videos.Count; i++)
                                        {
                                            var index = i;
                                            var video = EditModel.Videos[index];
                                            <div class="col-md-6 col-lg-4">
                                                <div class="card h-100 shadow-sm">
                                                    <div class="position-relative">
                                                        @if (!string.IsNullOrEmpty(video.ThumbnailUrl))
                                                        {
                                                            <img src="@video.ThumbnailUrl" alt="Video Thumbnail"
                                                                 class="card-img-top" style="height: 160px; object-fit: cover; cursor: pointer;"
                                                                 @onclick="() => PlayVideo(video.FileUrl, Video)" />
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-dark d-flex align-items-center justify-content-center"
                                                                 style="height: 160px; cursor: pointer;"
                                                                 @onclick="() => PlayVideo(video.FileUrl, Video)">
                                                                <i class="bi bi-play-circle-fill text-white fs-1"></i>
                                                            </div>
                                                        }
                                                        <div class="position-absolute top-0 end-0 m-2">
                                                            <button class="btn btn-sm btn-danger rounded-circle"
                                                                    style="width: 28px; height: 28px; padding: 0;"
                                                                    @onclick="() => RemoveVideo(index)">
                                                                <i class="bi bi-x small"></i>
                                                            </button>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(video.Duration))
                                                        {
                                                            <div class="position-absolute bottom-0 end-0 m-2">
                                                                <span class="badge bg-dark">@video.Duration</span>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="card-body p-2">
                                                        <small class="text-muted text-truncate d-block">@(video.FileUrl?.Length > 40 ? video.FileUrl.Substring(0, 40) + "..." : video.FileUrl)</small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    @if (!EditModel.Videos.Any())
                                    {
                                        <p class="text-muted small text-center py-3">No videos added</p>
                                    }
                                </div>

                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(VideosSection)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(VideosSection)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                @if (Vehicle.Videos?.Any() == true)
                                {
                                    <div class="row g-3">
                                        @foreach (var video in Vehicle.Videos.Take(6))
                                        {
                                            <div class="col-md-4 col-lg-3">
                                                <div class="card shadow-sm border-0" style="cursor: pointer;" @onclick="() => PlayVideo(video.FileUrl, Video)">
                                                    @if (!string.IsNullOrEmpty(video.ThumbnailUrl))
                                                    {
                                                        <img src="@video.ThumbnailUrl" alt="Video" class="card-img-top rounded" style="height: 100px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-dark d-flex align-items-center justify-content-center rounded-top" style="height: 100px;">
                                                            <i class="bi bi-play-circle-fill text-white fs-2"></i>
                                                        </div>
                                                    }
                                                    <div class="card-body p-2">
                                                        <small class="text-muted text-truncate d-block">@(video.FileUrl?.Length > 35 ? video.FileUrl.Substring(0, 35) + "..." : video.FileUrl)</small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        @if (Vehicle.Videos.Count > 6)
                                        {
                                            <div class="col-12">
                                                <small class="text-muted">+ @(Vehicle.Videos.Count - 6) more videos</small>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">No videos added</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN -->
            <div class="col-lg-6">

                <!-- Section 5: Arrival Settings -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-calendar-range me-2"></i>Arrival Settings
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleSectionEdit(ArrivalSettingsSection)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (EditingSections.Contains(ArrivalSettingsSection))
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Arrival Period</label>
                                    <select class="form-select" @bind="EditModel.ArrivalPeriod">
                                        <option value="weekly">Weekly</option>
                                        <option value="monthly">Monthly</option>
                                        <option value="yearly">Yearly</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Rating (0-5)</label>
                                    <input type="number" step="0.1" min="0" max="5" class="form-control" @bind="EditModel.Rating" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Review Count</label>
                                    <input type="number" class="form-control" @bind="EditModel.ReviewCount" />
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(ArrivalSettingsSection)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(ArrivalSettingsSection)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Arrival Period</small>
                                    <span class="badge @GetArrivalPeriodBadgeClass(Vehicle.ArrivalPeriod)">@Vehicle.ArrivalPeriod</span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Arrival Date</small>
                                    <span>@Vehicle.ArrivalDate.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Featured</small>
                                    @if (Vehicle.Featured)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>Featured</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Not Featured</span>
                                    }
                                </div>
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Rating</small>
                                    <span>@Vehicle.Rating.ToString("F1") (@Vehicle.ReviewCount reviews)</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Section 6: Variants -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-layers me-2"></i>Variants
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleSectionEdit(VariantsSection)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (EditingSections.Contains(VariantsSection))
                        {
                            <div class="row g-3">
                                <div class="col-12">
                                    <button class="btn btn-sm btn-outline-primary mb-2" @onclick="AddVariant">
                                        <i class="bi bi-plus-circle me-1"></i>Add Variant
                                    </button>

                                    @for (int i = 0; i < EditModel.Variants.Count; i++)
                                    {
                                        var index = i;
                                        var variant = EditModel.Variants[index];
                                        <div class="border rounded p-3 mb-2">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <strong>Variant @(index + 1)</strong>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveVariant(index)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                            <div class="row g-2">
                                                <div class="col-md-6">
                                                    <label class="form-label small">Variant Name</label>
                                                    <input type="text" class="form-control form-control-sm" @bind="EditModel.Variants[index].VariantName" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">Variant Short Name</label>
                                                    <input type="text" class="form-control form-control-sm" @bind="EditModel.Variants[index].VariantShortName" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">Variant Slug</label>
                                                    <input type="text" class="form-control form-control-sm" @bind="EditModel.Variants[index].VariantSlug" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">Ex-Showroom Price</label>
                                                    <input type="text" class="form-control form-control-sm" @bind="EditModel.Variants[index].ExShowRoomPrice" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">On-Road Price</label>
                                                    <input type="text" class="form-control form-control-sm" @bind="EditModel.Variants[index].OnRoadPrice" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">Fuel Type</label>
                                                    <input type="text" class="form-control form-control-sm" @bind="EditModel.Variants[index].FuelType" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">Transmission</label>
                                                    <input type="text" class="form-control form-control-sm" @bind="EditModel.Variants[index].Transmission" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">Mileage</label>
                                                    <input type="text" class="form-control form-control-sm" @bind="EditModel.Variants[index].Mileage" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">Engine CC</label>
                                                    <input type="text" class="form-control form-control-sm" @bind="EditModel.Variants[index].EngineCc" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">Tag (Base/Top Model)</label>
                                                    <input type="text" class="form-control form-control-sm" @bind="EditModel.Variants[index].Tag" />
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" @bind="EditModel.Variants[index].IsRecentLaunch" />
                                                        <label class="form-check-label small">Recent Launch</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" @bind="EditModel.Variants[index].IsTopSelling" />
                                                        <label class="form-check-label small">Top Selling</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (!EditModel.Variants.Any())
                                    {
                                        <p class="text-muted small text-center py-2">No variants added</p>
                                    }
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(VariantsSection)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(VariantsSection)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                @if (Vehicle.Variants?.Any() == true)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-borderless">
                                            <thead>
                                                <tr class="small text-muted">
                                                    <th>Variant</th>
                                                    <th>Fuel</th>
                                                    <th>Transmission</th>
                                                    <th>Price</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var variant in Vehicle.Variants.Take(5))
                                                {
                                                    <tr class="small">
                                                        <td class="fw-medium">@variant.VariantName</td>
                                                        <td>@variant.FuelType</td>
                                                        <td>@variant.Transmission</td>
                                                        <td class="text-primary">@variant.ExShowRoomPrice</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    @if (Vehicle.Variants.Count > 5)
                                    {
                                        <small class="text-muted">+ @(Vehicle.Variants.Count - 5) more variants</small>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">No variants added</p>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Section 7: SEO Information -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-search me-2"></i>SEO Information
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleSectionEdit(SeoSection)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (EditingSections.Contains(SeoSection))
                        {
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label small fw-medium">Page Title</label>
                                    <input type="text" class="form-control" @bind="EditModel.PageTitle" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-medium">Meta Description</label>
                                    <textarea class="form-control" rows="2" @bind="EditModel.DescriptionText"></textarea>
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(SeoSection)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(SeoSection)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                <div class="mb-2">
                                    <small class="text-muted d-block">Page Title</small>
                                    <span>@Vehicle.PageTitle</span>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Description</small>
                                    <p class="small mb-0">@(Vehicle.DescriptionText?.Length > 150 ? Vehicle.DescriptionText.Substring(0, 150) + "..." : Vehicle.DescriptionText)</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Video Player Modal -->
@if (ShowVideoModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.95)" @onclick="CloseVideoModal">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body p-0">
                    <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3"
                            style="width: 40px; height: 40px; z-index: 1060; background: white; border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.3);"
                            @onclick="CloseVideoModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <div class="ratio ratio-16x9">
                        <iframe id="videoPlayer"
                                src="@GetYouTubeEmbedUrl(SelectedVideoUrl)"
                                title="YouTube video player"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen
                                sandbox="allow-same-origin allow-scripts allow-popups allow-forms allow-presentation">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Save Confirmation Modal -->
@if (ShowSaveConfirmation)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Save Changes</h5>
                    <button type="button" class="btn-close" @onclick="CloseSaveConfirmation"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to save all changes?</p>
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        Sections with changes: <strong>@string.Join(", ", ChangedSections)</strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseSaveConfirmation">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="ConfirmSaveAll" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-save me-1"></i>Save All
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .form-control, .form-select {
        font-size: 0.875rem;
    }

    .btn-sm {
        font-size: 0.8125rem;
    }

    .card-header {
        background-color: #fff;
    }

    .badge {
        font-weight: 500;
    }

    .modal.fade.show {
        background-color: rgba(0,0,0,0.5);
    }

    .ratio-16x9 {
        aspect-ratio: 16/9;
    }
</style>
                            <i class="bi bi-steering-wheel me-2"></i>Test Drive
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleSectionEdit(TestDrive)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (EditingSections.Contains(TestDrive))
                        {

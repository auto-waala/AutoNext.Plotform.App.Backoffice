                                </div>
                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(TestDrive)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(TestDrive)">
                                        Cancel
                                    </button>

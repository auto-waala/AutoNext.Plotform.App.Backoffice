</div>

<!-- Save Confirmation Modal -->
@if (ShowSaveConfirmation)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Save Changes</h5>
                    <button type="button" class="btn-close" @onclick="CloseSaveConfirmation"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to save all changes?</p>
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        Sections with changes: <strong>@string.Join(", ", ChangedSections)</strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseSaveConfirmation">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="ConfirmSaveAll" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-save me-1"></i>Save All
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .form-control, .form-select {
        font-size: 0.875rem;
    }

    .btn-sm {
        font-size: 0.8125rem;
    }

    .card-header {
        background-color: #fff;
    }

    .badge {
        font-weight: 500;
    }
</style>
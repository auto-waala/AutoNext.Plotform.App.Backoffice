                                                </div>
                                            }
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-success" @onclick="AddShort">
                                                    <i class="bi bi-check me-1"></i>Add
                                                </button>
                                                <button class="btn btn-sm btn-secondary" @onclick="CancelShort">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="col-12">
                                    <label class="form-label small fw-bold">Current Shorts (@EditModel.Shorts.Count)</label>
                                    @for (int i = 0; i < EditModel.Shorts.Count; i++)
                                    {
                                        var index = i;
                                        var shortVideo = EditModel.Shorts[index];
                                        <div class="border rounded p-2 mb-2 d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-3">
                                                @if (!string.IsNullOrEmpty(shortVideo.ThumbnailUrl))
                                                {
                                                    <img src="@shortVideo.ThumbnailUrl" alt="Short" style="height: 40px; width: 40px; object-fit: cover;" class="rounded" />
                                                }
                                                else
                                                {
                                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                        <i class="bi bi-camera-reels text-muted"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <div class="small">@(shortVideo.FileUrl?.Length > 50 ? shortVideo.FileUrl.Substring(0, 50) + "..." : shortVideo.FileUrl)</div>
                                                    @if (!string.IsNullOrEmpty(shortVideo.Duration))
                                                    {
                                                        <small class="text-muted">@shortVideo.Duration</small>
                                                    }
                                                </div>
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveShort(index)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    }
                                    @if (!EditModel.Shorts.Any())
                                    {
                                        <p class="text-muted small text-center py-2">No shorts added</p>
                                    }
                                </div>

                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(Shorts)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(Shorts)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                @if (Vehicle.Shorts?.Any() == true)
                                {
                                    <div class="d-flex gap-2 flex-wrap">
                                        @foreach (var shortVideo in Vehicle.Shorts.Take(4))
                                        {
                                            <div class="text-center">
                                                @if (!string.IsNullOrEmpty(shortVideo.ThumbnailUrl))
                                                {
                                                    <img src="@shortVideo.ThumbnailUrl" alt="Short" style="height: 50px; width: 50px; object-fit: cover;" class="rounded" />
                                                }
                                                else
                                                {
                                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 50px; width: 50px;">
                                                        <i class="bi bi-camera-reels fs-4 text-muted"></i>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        @if (Vehicle.Shorts.Count > 4)
                                        {
                                            <div class="d-flex align-items-center">
                                                <span class="badge bg-secondary">+@(Vehicle.Shorts.Count - 4)</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">No shorts added</p>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Section 9: Pros & Cons -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-hand-thumbs-up me-2"></i>Pros & Cons
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleSectionEdit(ProsCons)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (EditingSections.Contains(ProsCons))
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-success">Pros</label>
                                    <div id="pros-container">
                                        @for (int i = 0; i < EditModel.Pros.Count; i++)
                                        {
                                            var index = i;
                                            <div class="input-group input-group-sm mb-2">
                                                <input type="text" class="form-control" @bind="EditModel.Pros[index].Pro" />
                                                <button class="btn btn-outline-danger" type="button" @onclick="() => RemovePro(index)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <button class="btn btn-sm btn-outline-success mt-1" @onclick="AddPro">
                                        <i class="bi bi-plus"></i> Add Pro
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-danger">Cons</label>
                                    <div id="cons-container">
                                        @for (int i = 0; i < EditModel.Cons.Count; i++)
                                        {
                                            var index = i;
                                            <div class="input-group input-group-sm mb-2">
                                                <input type="text" class="form-control" @bind="EditModel.Cons[index].Con" />
                                                <button class="btn btn-outline-danger" type="button" @onclick="() => RemoveCon(index)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger mt-1" @onclick="AddCon">
                                        <i class="bi bi-plus"></i> Add Con
                                    </button>
                                </div>
                                <div class="col-12 mt-3">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(ProsCons)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(ProsCons)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">

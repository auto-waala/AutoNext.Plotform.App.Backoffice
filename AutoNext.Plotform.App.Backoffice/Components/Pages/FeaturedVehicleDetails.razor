                                    {
                                        <ul class="small mb-0">
                                            @foreach (var pro in Vehicle.Pros)
                                            {
                                                <li>@pro.Pro</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="text-muted small">No pros added</p>
                                    }
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block mb-2">Cons</small>
                                    @if (Vehicle.Cons?.Any() == true)
                                    {
                                        <ul class="small mb-0">
                                            @foreach (var con in Vehicle.Cons)
                                            {
                                                <li>@con.Con</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="text-muted small">No cons added</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Section 10: Seller & Location -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-building me-2"></i>Seller & Location
                        </h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleSectionEdit(Seller)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    </div>
                    <div class="card-body">
                        @if (EditingSections.Contains(Seller))
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Seller Name</label>
                                    <input type="text" class="form-control" @bind="EditModel.Seller.Name" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-medium">Email</label>
                                    <input type="email" class="form-control" @bind="EditModel.Seller.Email" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-medium">City</label>
                                    <input type="text" class="form-control" @bind="EditModel.Location.City" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-medium">State</label>
                                    <input type="text" class="form-control" @bind="EditModel.Location.State" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-medium">Pincode</label>
                                    <input type="text" class="form-control" @bind="EditModel.Location.Pincode" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-medium">Full Address</label>
                                    <textarea class="form-control" rows="2" @bind="EditModel.Location.FullAddress"></textarea>
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveSection(Seller)">
                                        <i class="bi bi-check-circle me-1"></i>Save Section
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CancelSectionEdit(Seller)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Seller Name</small>
                                    <span class="fw-medium">@Vehicle.Seller?.Name</span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">City</small>
                                    <span>@Vehicle.Location?.City</span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">State</small>
                                    <span>@Vehicle.Location?.State</span>
                                </div>

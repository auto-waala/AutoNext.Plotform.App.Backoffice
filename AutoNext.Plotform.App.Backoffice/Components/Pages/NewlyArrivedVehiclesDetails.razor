@page "/newly-arrived-vehicles/{VehicleId}"
@inherits NewlyArrivedVehicleDetailsBase

<div class="container-fluid px-0">
    @if (IsLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-3 small">Loading vehicle details...</p>
        </div>
    }
    else if (Vehicle == null)
    {
        <div class="text-center py-5">
            <i class="bi bi-car-front-fill fs-1 text-muted"></i>
            <h5 class="mt-3">Vehicle not found</h5>
            <button class="btn btn-primary mt-2" @onclick="GoBack">Back to List</button>
        </div>
    }
    else
    {
        <!-- Main Content -->
        <div class="row g-0">
            <!-- Left Column - Media Section -->
            <div class="col-lg-7 pe-lg-3">
                <!-- Image Gallery -->
                <div class="card shadow-sm mb-4">
                    <div class="card-body p-0">
                        <div class="position-relative">
                            <!-- Main Image -->
                            <div class="position-relative">
                                <img src="@GetMainImage()"
                                     alt="@Vehicle.BrandName @Vehicle.ModelName"
                                     class="img-fluid w-100"
                                     style="height: 400px; object-fit: cover;"
                                     @onclick="OpenImageViewer" />

                                <!-- Photo Count Badge -->
                                <button class="btn btn-sm btn-dark position-absolute bottom-0 end-0 m-3 rounded-pill"
                                        style="opacity: 0.8;"
                                        @onclick="OpenImageViewer">
                                    <i class="bi bi-images me-1"></i> @(Vehicle.Images?.Count ?? 0) Photos
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shorts / Videos Section -->
                @if (Vehicle.Videos?.Any() == true)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white border-bottom">
                            <h6 class="mb-0 fw-bold">Shorts</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @foreach (var video in Vehicle.Videos.Take(3))
                                {
                                    <div class="col-md-4">
                                        <div class="position-relative cursor-pointer" @onclick="() => PlayVideo(video)">
                                            <img src="@video.Image" alt="@video.Title" class="img-fluid rounded" style="height: 180px; width: 100%; object-fit: cover;" />
                                            <div class="position-absolute top-50 start-50 translate-middle">
                                                <i class="bi bi-play-circle-fill text-white fs-1" style="opacity: 0.9;"></i>
                                            </div>
                                            <div class="position-absolute bottom-0 start-0 m-2">
                                                <span class="badge bg-dark">@video.Duration</span>
                                            </div>
                                        </div>
                                        <p class="small text-muted mt-2 mb-0 text-truncate">@video.Title</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Colors Section -->
                @if (Colors.Any())
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white border-bottom">
                            <h6 class="mb-0 fw-bold">@Vehicle.BrandName @Vehicle.ModelName Colors</h6>
                            <small class="text-muted">@Colors.Count Colors</small>
                        </div>
                        <div class="card-body">
                            <div class="d-flex gap-3 flex-wrap">
                                @foreach (var color in Colors)
                                {
                                    <div class="text-center" style="width: 80px;">
                                        <div class="rounded-circle border shadow-sm mx-auto mb-2"
                                             style="width: 50px; height: 50px; background-color: @color.Code; cursor: pointer;"
                                             @onclick="() => SelectColor(color)">
                                        </div>
                                        <span class="small">@color.Name</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Right Column - Details Section -->
            <div class="col-lg-5 ps-lg-3">
                <!-- Title & Rating -->
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h2 class="h4 mb-1 fw-bold">@Vehicle.BrandName @Vehicle.ModelName</h2>
                                <p class="text-muted small mb-0">@Vehicle.BodyType</p>
                            </div>
                            <span class="badge bg-light text-dark border">@Vehicle.VehicleType</span>
                        </div>

                        <!-- Rating -->
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="bg-success text-white px-2 py-1 rounded">
                                <span class="fw-bold">@Vehicle.Rating.ToString("F1")</span>
                                <i class="bi bi-star-fill ms-1 small"></i>
                            </div>
                            <span class="text-muted small">@Vehicle.ReviewCount Reviews</span>
                            <button class="btn btn-link btn-sm text-decoration-none p-0" @onclick="RateVehicle">
                                Rate &amp; Win &#8377;1000
                            </button>
                        </div>

                        <!-- Description -->
                        <p class="small text-muted mb-3">
                            @Vehicle.DescriptionText
                            @* FIX: Use @onclick:preventDefault to stop the anchor from navigating *@
                            <a href="#" @onclick="ReadMore" @onclick:preventDefault class="text-decoration-none">more</a>
                        </p>

                        <!-- Price -->
                        <div class="mb-3">
                            <h3 class="text-primary mb-0">
                                @FormatPrice(Vehicle.MinPrice)
                                @if (Vehicle.MaxPrice > Vehicle.MinPrice)
                                {
                                    <span class="text-muted fs-6"> - @FormatPrice(Vehicle.MaxPrice)</span>
                                }
                            </h3>
                            <small class="text-muted">*Ex-Showroom Price in Hyderabad</small>
                            <div class="mt-2">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="GetOnRoadPrice">
                                    Get On-Road Price
                                </button>
                                <button class="btn btn-sm btn-warning" @onclick="ViewMayOffers">
                                    View May Offers
                                </button>
                            </div>
                            <div class="alert alert-warning mt-2 py-2 small mb-0">
                                <i class="bi bi-gift me-1"></i> Hurry up to lock festive offers!
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Specs & Features Tabs -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white border-bottom">
                        <ul class="nav nav-tabs card-header-tabs" role="tablist">
                            <li class="nav-item">
                                @* FIX: Use single quotes inside the @onclick string to avoid Razor parse error *@
                                <button class="nav-link @(ActiveTab == "specs" ? "active" : "")" @onclick="() => SetActiveTab(ActiveTab)">
                                    Specs &amp; Features
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(ActiveTab == "standout" ? "active" : "")"
                                        @onclick="() => SetActiveTab(SecondTab)">
                                    Stand Out Features
                                </button>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        @if (ActiveTab == "specs")
                        {
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="border rounded p-2 mb-2">
                                        <small class="text-muted d-block">Engine</small>
                                        <span class="fw-medium">@GetEngineSpecs()</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 mb-2">
                                        <small class="text-muted d-block">Power</small>
                                        <span class="fw-medium">@GetPowerSpecs()</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 mb-2">
                                        <small class="text-muted d-block">Torque</small>
                                        <span class="fw-medium">@GetTorqueSpecs()</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 mb-2">
                                        <small class="text-muted d-block">Ground Clearance</small>
                                        <span class="fw-medium">@GetGroundClearance()</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 mb-2">
                                        <small class="text-muted d-block">Seating Capacity</small>
                                        <span class="fw-medium">5</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 mb-2">
                                        <small class="text-muted d-block">Drive Type</small>
                                        <span class="fw-medium">FWD</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-6">
                                    <div class="text-center p-3">
                                        <i class="bi bi-star fs-2 text-warning"></i>
                                        <p class="small mt-2 mb-0">Premium Design</p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="text-center p-3">
                                        <i class="bi bi-shield-check fs-2 text-success"></i>
                                        <p class="small mt-2 mb-0">5-Star Safety</p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="text-center p-3">
                                        <i class="bi bi-wifi fs-2 text-info"></i>
                                        <p class="small mt-2 mb-0">Connected Tech</p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="text-center p-3">
                                        <i class="bi bi-fuel-pump fs-2 text-danger"></i>
                                        <p class="small mt-2 mb-0">Fuel Efficient</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Variants Section -->
                @if (Vehicle.Variants?.Any() == true)
                {
                    <div class="card shadow-sm">
                        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold">@Vehicle.BrandName @Vehicle.ModelName price</h6>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary @(SelectedFuelType == "all" ? "active" : "")"
                                        @onclick='() => FilterVariantsByFuel("all")'>
                                    All
                                </button>
                                @foreach (var fuel in FuelTypes)
                                {
                                    var fuelCapture = fuel;
                                    <button class="btn btn-outline-secondary @(SelectedFuelType == fuelCapture ? "active" : "")"
                                            @onclick="() => FilterVariantsByFuel(fuelCapture)">
                                        @fuelCapture
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Variant</th>
                                            <th>Ex-Showroom Price</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var variant in FilteredVariants)
                                        {
                                            var variantCapture = variant;
                                            <tr>
                                                <td>
                                                    <div>
                                                        <span class="fw-medium">@variantCapture.VariantName</span>
                                                        @if (variantCapture.Tag?.Contains("Base") == true)
                                                        {
                                                            <span class="badge bg-secondary ms-1">Base Model</span>
                                                        }
                                                        @if (variantCapture.Tag?.Contains("Top") == true)
                                                        {
                                                            <span class="badge bg-warning text-dark ms-1">Top Model</span>
                                                        }
                                                        <div class="small text-muted">
                                                            @variantCapture.FuelType | @variantCapture.Transmission
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="fw-bold text-primary">
                                                    @FormatVariantPrice(variantCapture.OnRoadPriceValue)
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => ViewVariantDetails(variantCapture)">
                                                        View
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Expert Review Section -->
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0 fw-bold">Expert Review</h5>
            </div>
            <div class="card-body">
                <div class="d-flex gap-3 mb-3">
                    <div class="text-center">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 70px; height: 70px;">
                            <span class="fs-2 fw-bold">@Vehicle.Rating.ToString("F1")</span>
                        </div>
                        <small class="text-muted">Expert Verdict</small>
                    </div>
                    <div class="flex-grow-1">
                        <p class="small mb-2">Tata has nailed it hard with the @Vehicle.ModelName in almost all aspects...</p>
                        <div class="row mt-2">
                            <div class="col-6">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Exterior</span>
                                    <span class="fw-bold">4.5</span>
                                </div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Interior</span>
                                    <span class="fw-bold">4.0</span>
                                </div>
                                <div class="d-flex justify-content-between small">
                                    <span>Safety</span>
                                    <span class="fw-bold">5.0</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Drive Experience</span>
                                    <span class="fw-bold">4.0</span>
                                </div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Comfort</span>
                                    <span class="fw-bold">4.2</span>
                                </div>
                                <div class="d-flex justify-content-between small">
                                    <span>Value for Money</span>
                                    <span class="fw-bold">4.3</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="border-start border-success border-3 ps-3">
                            <h6 class="fw-bold text-success mb-2">
                                <i class="bi bi-check-circle-fill me-1"></i> Good Things
                            </h6>
                            <ul class="small mb-0 ps-3">
                                <li>Smashing design! Looks larger than it actually is and has great road presence.</li>
                                <li>Petrol and diesel engine options, both with manual and automatic.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border-start border-danger border-3 ps-3">
                            <h6 class="fw-bold text-danger mb-2">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Could Be Better
                            </h6>
                            <ul class="small mb-0 ps-3">
                                <li>Diesel engine refinement could be better</li>
                                <li>Minor omissions: powered co-driver's seat, rear seat recline etc.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button class="btn btn-outline-primary btn-sm" @onclick="ReadCompleteReview">
                        Read Complete Expert Review
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Image Viewer Modal -->
@if (ShowImageViewer)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.9)" @onclick="CloseImageViewer">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body d-flex align-items-center justify-content-center"
                     @onclick:stopPropagation>
                    @* FIX: stopPropagation on inner div so clicking the image/close button
                       doesn't bubble up and trigger CloseImageViewer on the backdrop *@
                    <img src="@CurrentImageUrl" alt="Vehicle Image" class="img-fluid" style="max-height: 90vh;" />
                    <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3"
                            @onclick="CloseImageViewer">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Video Modal -->
@if (ShowVideoPlayer)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.9)" @onclick="CloseVideoPlayer">
        <div class="modal-dialog modal-lg">
            <div class="modal-content bg-dark" @onclick:stopPropagation>
                @* FIX: stopPropagation so clicking inside the video modal doesn't close it *@
                <div class="modal-body p-0">
                    <iframe width="100%" height="500"
                            src="@GetYouTubeEmbedUrl(CurrentVideo?.Url)"
                            frameborder="0" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
}

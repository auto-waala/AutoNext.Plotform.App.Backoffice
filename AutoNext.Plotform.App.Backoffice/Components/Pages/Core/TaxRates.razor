@page "/tax-rates"
@inherits TaxRatesBase

<div class="container-fluid" style="padding-left: 0px; padding-right: 0px;">
    <div class="row" style="padding-left: 0px; padding-right: 0px;">
        <div class="col">
            <div class="card taxrates-card">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex justify-content-between align-items-center py-1">
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <h5 class="mb-0">
                                <i class="bi bi-calculator text-primary me-2"></i>Tax Rates
                            </h5>
                            <span class="badge bg-light text-dark ms-2">
                                <span class="text-primary fw-bold">@TotalCount</span> tax rates
                            </span>
                            @if (SelectedTaxRates.Any())
                            {
                                <span class="badge bg-primary ms-1">@SelectedTaxRates.Count selected</span>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (SelectedTaxRates.Any())
                            {
                                <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1"
                                        @onclick="BulkDelete">
                                    <i class="bi bi-trash"></i>
                                    <span class="d-none d-sm-inline">Delete (@SelectedTaxRates.Count)</span>
                                </button>
                            }
                            <button class="btn btn-sm btn-primary d-flex align-items-center gap-1"
                                    @onclick="OpenAddTaxRateSidebar">
                                <i class="bi bi-plus-circle"></i>
                                <span class="d-none d-sm-inline">New Tax Rate</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Filter Bar -->
                <div class="card-body border-bottom bg-light">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Search</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Name or code..."
                                       @bind="SearchTerm" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">Tax Type</label>
                            <select class="form-select form-select-sm" @bind="TaxTypeFilter" @bind:event="onchange">
                                <option value="">All Types</option>
                                @foreach (var taxType in AvailableTaxTypes)
                                {
                                    <option value="@taxType">@taxType</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">Country</label>
                            <select class="form-select form-select-sm" @bind="CountryFilter" @bind:event="onchange">
                                <option value="">All Countries</option>
                                @foreach (var country in AvailableCountries)
                                {
                                    <option value="@country">@country</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">Compound</label>
                            <select class="form-select form-select-sm" @bind="CompoundFilter" @bind:event="onchange">
                                <option value="">All</option>
                                <option value="true">Compound</option>
                                <option value="false">Simple</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">Status</label>
                            <select class="form-select form-select-sm" @bind="ActiveFilter" @bind:event="onchange">
                                <option value="">All</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="ClearFilters">
                                <i class="bi bi-eraser"></i> Clear
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-0">
                    @if (IsLoading)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="text-muted mt-3 small">Loading tax rates...</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover taxrates-table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px">
                                            <input type="checkbox"
                                                   checked="@AllPageSelected"
                                                   @onchange="_ => ToggleAllSelection()" />
                                        </th>
                                        <th>Name</th>
                                        <th>Code</th>
                                        <th>Rate</th>
                                        <th>Location</th>
                                        <th>Type</th>
                                        <th class="text-center">Order</th>
                                        <th>Status</th>
                                        <th>Effective</th>
                                        <th style="width: 140px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (PaginatedTaxRates.Any())
                                    {
                                        @foreach (var taxRate in PaginatedTaxRates)
                                        {
                                            var localTaxRate = taxRate;
                                            <tr>
                                                <td>
                                                    <input type="checkbox"
                                                           checked="@SelectedTaxRates.Contains(localTaxRate)"
                                                           @onchange="e => OnTaxRateSelectionChanged(localTaxRate, (bool)e.Value!)" />
                                                </td>
                                                <td>
                                                    <div>
                                                        <strong>@localTaxRate.Name</strong>
                                                    </div>
                                                </td>
                                                <td>
                                                    <code class="small">@localTaxRate.Code</code>
                                                </td>
                                                <td>
                                                    <span class="fw-bold text-success">@localTaxRate.RatePercentage:F1%</span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(localTaxRate.Country))
                                                    {
                                                        <span class="badge bg-info">@localTaxRate.Country</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(localTaxRate.State))
                                                    {
                                                        <span class="badge bg-secondary ms-1">@localTaxRate.State</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge @(localTaxRate.IsCompound ? "bg-warning text-dark" : "bg-primary")">
                                                        @(localTaxRate.IsCompound ? "Compound" : "Simple")
                                                    </span>
                                                </td>
                                                <td class="text-center">@localTaxRate.DisplayOrder</td>
                                                <td>
                                                    <span class="badge @GetStatusBadgeClass(localTaxRate.IsActive)">
                                                        @GetStatusText(localTaxRate.IsActive)
                                                    </span>
                                                </td>
                                                <td>
                                                    @localTaxRate.EffectiveFrom.ToString("yyyy-MM-dd")
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <button class="btn btn-outline-primary"
                                                                @onclick="() => OpenEditTaxRateSidebar(localTaxRate)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-outline-warning"
                                                                @onclick="() => ToggleStatus(localTaxRate)">
                                                            <i class="bi @(localTaxRate.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger"
                                                                @onclick="() => DeleteTaxRate(localTaxRate)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="10" class="text-center py-5 text-muted">
                                                @if (!string.IsNullOrEmpty(SearchTerm) || !string.IsNullOrEmpty(TaxTypeFilter) || !string.IsNullOrEmpty(CountryFilter) || CompoundFilter != null || ActiveFilter != null)
                                                {
                                                    <div>
                                                        <i class="bi bi-filter-circle fs-1"></i>
                                                        <p class="mt-2">No tax rates match your filters</p>
                                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ClearFilters">
                                                            Clear Filters
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div>
                                                        <i class="bi bi-calculator fs-1"></i>
                                                        <p class="mt-2">No tax rates found</p>
                                                        <button class="btn btn-sm btn-primary mt-2" @onclick="OpenAddTaxRateSidebar">
                                                            <i class="bi bi-plus-circle"></i> Add First Tax Rate
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (TotalPages > 1)
                        {
                            <div class="pagination-container p-3 border-top">
                                <nav>
                                    <ul class="pagination justify-content-center mb-0">
                                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">
                                                Previous
                                            </button>
                                        </li>

                                        @for (int i = 1; i <= TotalPages; i++)
                                        {
                                            var pageNum = i;
                                            if (pageNum == 1 || pageNum == TotalPages || (pageNum >= CurrentPage - 2 && pageNum <= CurrentPage + 2))
                                            {
                                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                                    <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                                                </li>
                                            }
                                            else if (pageNum == CurrentPage - 3 || pageNum == CurrentPage + 3)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                        }

                                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">
                                                Next
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                </div>

                @if (!IsLoading && AllTaxRates.Any())
                {
                    <div class="card-footer bg-white border-top">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex gap-3 flex-wrap">
                                <small class="text-muted">
                                    <span class="fw-medium">@TotalCount</span> total
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-check-circle-fill text-success me-1"></i>
                                    <span class="fw-medium">@ActiveCount</span> active
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-x-circle-fill text-danger me-1"></i>
                                    <span class="fw-medium">@InactiveCount</span> inactive
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-calculator-fill text-primary me-1"></i>
                                    <span class="fw-medium">@CompoundCount</span> compound
                                </small>
                                <small class="text-muted">
                                    Showing @(((CurrentPage - 1) * ItemsPerPage) + 1) to
                                    @(Math.Min(CurrentPage * ItemsPerPage, TotalCount)) of @TotalCount entries
                                </small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <small class="text-muted">Show:</small>
                                <select class="form-select form-select-sm page-size-select" @onchange="OnPageSizeChanged">
                                    @foreach (var size in PageSizeOptions)
                                    {
                                        <option value="@size" selected="@(size == ItemsPerPage)">@size</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Sidebar Component -->
<TaxRateSidebar @bind-IsVisible="@showSidebar" TaxRateToEdit="@selectedTaxRate" OnSave="@OnTaxRateSave" />

<style>
    .taxrates-table tbody tr:hover {
        background-color: rgba(13, 202, 240, 0.05);
        cursor: pointer;
    }
    
    .page-size-select {
        width: auto;
        min-width: 70px;
    }
</style>
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

<div class="autonext-sidebar-overlay @(IsVisible ? "visible" : "")" @onclick="Close"></div>

<div class="autonext-sidebar @(IsVisible ? "visible" : "")">
    <EditForm Model="@LocationModel" OnValidSubmit="@HandleValidSubmit" FormName="locationForm">

        <!-- Header -->
        <div class="autonext-sidebar-header">
            <h5 class="autonext-sidebar-title">
                <i class="bi bi-geo-alt me-2"></i>
                @(IsEditMode ? "Edit Location" : "Add Location")
            </h5>
            <button type="button" class="autonext-sidebar-close" @onclick="Close" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <!-- Body -->
        <div class="autonext-sidebar-body">

            <!-- Country Section -->
            <div class="autonext-form-section">
                <h6 class="autonext-section-title">
                    <i class="bi bi-flag me-2"></i>Country
                </h6>

                <div class="autonext-form-group">
                    <label for="CountryName">Country Name <span class="text-danger">*</span></label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text"><i class="bi bi-globe"></i></span>
                        </div>
                        <InputText id="CountryName" class="autonext-form-control"
                                   placeholder="e.g., India"
                                   @bind-Value="LocationModel.CountryName" />
                    </div>
                    <ValidationMessage For="@(() => LocationModel.CountryName)" />
                </div>

                <div class="autonext-form-group">
                    <label for="CountryCode">Country Code <span class="text-danger">*</span></label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text"><i class="bi bi-upc-scan"></i></span>
                        </div>
                        <InputText id="CountryCode" class="autonext-form-control"
                                   placeholder="e.g., IN"
                                   @bind-Value="LocationModel.CountryCode" />
                    </div>
                    <ValidationMessage For="@(() => LocationModel.CountryCode)" />
                    <small class="autonext-text-muted">ISO 2-3 letter uppercase code (e.g., IN, USA)</small>
                </div>
            </div>

            <!-- State Section -->
            <div class="autonext-form-section">
                <h6 class="autonext-section-title">
                    <i class="bi bi-map me-2"></i>State
                </h6>

                <div class="autonext-form-group">
                    <label for="StateName">State Name <span class="text-danger">*</span></label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text"><i class="bi bi-map"></i></span>
                        </div>
                        <InputText id="StateName" class="autonext-form-control"
                                   placeholder="e.g., Telangana"
                                   @bind-Value="LocationModel.StateName" />
                    </div>
                    <ValidationMessage For="@(() => LocationModel.StateName)" />
                </div>

                <div class="autonext-form-group">
                    <label for="StateCode">State Code <span class="text-danger">*</span></label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text"><i class="bi bi-upc-scan"></i></span>
                        </div>
                        <InputText id="StateCode" class="autonext-form-control"
                                   placeholder="e.g., TS"
                                   @bind-Value="LocationModel.StateCode" />
                    </div>
                    <ValidationMessage For="@(() => LocationModel.StateCode)" />
                </div>
            </div>

            <!-- City Section -->
            <div class="autonext-form-section">
                <h6 class="autonext-section-title">
                    <i class="bi bi-building me-2"></i>City Details
                </h6>

                <div class="autonext-form-group">
                    <label for="CityName">City Name <span class="text-danger">*</span></label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text"><i class="bi bi-building"></i></span>
                        </div>
                        <InputText id="CityName" class="autonext-form-control"
                                   placeholder="e.g., Hyderabad"
                                   @bind-Value="LocationModel.CityName" />
                    </div>
                    <ValidationMessage For="@(() => LocationModel.CityName)" />
                </div>

                <div class="autonext-form-group">
                    <label for="District">District</label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text"><i class="bi bi-signpost"></i></span>
                        </div>
                        <InputText id="District" class="autonext-form-control"
                                   placeholder="e.g., Rangareddy"
                                   @bind-Value="LocationModel.District" />
                    </div>
                    <ValidationMessage For="@(() => LocationModel.District)" />
                </div>

                <div class="autonext-form-group">
                    <label for="Pincode">Pincode</label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text"><i class="bi bi-mailbox"></i></span>
                        </div>
                        <InputText id="Pincode" class="autonext-form-control"
                                   placeholder="e.g., 500032"
                                   @bind-Value="LocationModel.Pincode" />
                    </div>
                    <ValidationMessage For="@(() => LocationModel.Pincode)" />
                    <small class="autonext-text-muted">4-10 digit numeric code</small>
                </div>
            </div>

            <!-- Coordinates Section -->
            <div class="autonext-form-section"> 
                <h6 class="autonext-section-title">
                    <i class="bi bi-pin-map me-2"></i>Coordinates (Optional)
                </h6>

                <div class="autonext-form-group">
                    <label for="Latitude">Latitude</label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text"><i class="bi bi-arrows-vertical"></i></span>
                        </div>
                        <InputNumber id="Latitude" class="autonext-form-control"
                                     placeholder="e.g., 17.3850"
                                     @bind-Value="LocationModel.Latitude" />
                    </div>
                </div>

                <div class="autonext-form-group">
                    <label for="Longitude">Longitude</label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text"><i class="bi bi-arrows"></i></span>
                        </div>
                        <InputNumber id="Longitude" class="autonext-form-control"
                                     placeholder="e.g., 78.4867"
                                     @bind-Value="LocationModel.Longitude" />
                    </div>
                </div>
            </div>

            <!-- Status Section -->
            <div class="autonext-form-section">
                <h6 class="autonext-section-title">
                    <i class="bi bi-toggles me-2"></i>Status
                </h6>

                <div class="autonext-form-group">
                    <div class="autonext-form-check">
                        <InputCheckbox id="IsActive" class="autonext-form-check-input"
                                       @bind-Value="LocationModel.IsActive" />
                        <label class="autonext-form-check-label" for="IsActive">
                            <i class="bi @(LocationModel.IsActive ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") me-1"></i>
                            Active Status
                        </label>
                    </div>
                    <small class="autonext-text-muted">Inactive locations won't be available for selection</small>
                </div>
            </div>

            <!-- Usage Information -->
            @if (IsEditMode && LocationModel.CreatedAt.HasValue)
            {
                <div class="autonext-form-section">
                    <h6 class="autonext-section-title">
                        <i class="bi bi-clock-history me-2"></i>Usage Information
                    </h6>
                    <div class="autonext-info-grid">
                        <div class="autonext-info-item">
                            <span class="autonext-info-label">Created:</span>
                            <span class="autonext-info-value">@LocationModel.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        @if (LocationModel.UpdatedAt.HasValue)
                        {
                            <div class="autonext-info-item">
                                <span class="autonext-info-label">Last Updated:</span>
                                <span class="autonext-info-value">@LocationModel.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Footer -->
        <div class="autonext-sidebar-footer">
            <button type="button" class="btn btn-secondary me-2" @onclick="Close">
                <i class="bi bi-x-circle me-1"></i> Cancel
            </button>
            <button type="submit" class="btn btn-primary">
                <i class="bi @(IsEditMode ? "bi-pencil" : "bi-save") me-1"></i>
                @(IsEditMode ? "Update Location" : "Save Location")
            </button>
        </div>
    </EditForm>
</div>

<style>
    .autonext-sidebar-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1040;
    }
    .autonext-sidebar-overlay.visible { display: block; }

    .autonext-sidebar {
        position: fixed;
        top: 0;
        right: -500px;
        width: 500px;
        max-width: 90vw;
        height: 100vh;
        background-color: white;
        box-shadow: -2px 0 8px rgba(0,0,0,0.15);
        z-index: 1050;
        display: flex;
        flex-direction: column;
        transition: right 0.3s ease-in-out;
    }
    .autonext-sidebar.visible { right: 0; }

    .autonext-sidebar-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .autonext-sidebar-title { margin: 0; font-size: 1.1rem; font-weight: 600; }
    .autonext-sidebar-close {
        background: none; border: none;
        font-size: 1.5rem; line-height: 1;
        cursor: pointer; padding: 0; color: #6c757d;
    }
    .autonext-sidebar-body { flex: 1; overflow-y: auto; padding: 1.5rem; }
    .autonext-sidebar-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #dee2e6;
        display: flex;
        justify-content: flex-end;
    }
    .autonext-form-section { margin-bottom: 1.5rem; }
    .autonext-section-title {
        font-size: 0.9rem; font-weight: 600;
        margin-bottom: 1rem; padding-bottom: 0.5rem;
        border-bottom: 2px solid #e9ecef;
    }
    .autonext-form-group { margin-bottom: 1rem; }
    .autonext-form-group label {
        display: block; margin-bottom: 0.5rem;
        font-size: 0.85rem; font-weight: 500; color: #495057;
    }
    .autonext-input-group { display: flex; }
    .autonext-input-group-prepend { display: flex; }
    .autonext-input-group-text {
        display: flex; align-items: center;
        padding: 0.375rem 0.75rem;
        font-size: 0.9rem; color: #495057;
        background-color: #e9ecef;
        border: 1px solid #ced4da;
        border-radius: 0.25rem 0 0 0.25rem;
    }
    .autonext-form-control {
        display: block; width: 100%;
        padding: 0.375rem 0.75rem;
        font-size: 0.9rem; line-height: 1.5;
        color: #212529; background-color: #fff;
        border: 1px solid #ced4da;
        border-radius: 0 0.25rem 0.25rem 0;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }
    .autonext-form-check { display: flex; align-items: center; gap: 0.5rem; }
    .autonext-form-check-input { width: 1rem; height: 1rem; margin-top: 0; }
    .autonext-form-check-label { margin-bottom: 0; font-weight: normal; cursor: pointer; }
    .autonext-text-muted { display: block; margin-top: 0.25rem; font-size: 0.75rem; color: #6c757d; }
    .autonext-info-grid {
        display: grid; grid-template-columns: auto 1fr;
        gap: 0.5rem 1rem; font-size: 0.85rem;
    }
    .autonext-info-label { font-weight: 600; color: #495057; }
    .autonext-info-value { color: #212529; }
    .validation-message { font-size: 0.75rem; color: #dc3545; margin-top: 0.25rem; }
</style>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public AutoNext.Plotform.App.Backoffice.Models.Core.Location? LocationToEdit { get; set; }
    [Parameter] public EventCallback<AutoNext.Plotform.App.Backoffice.Models.Core.Location> OnSave { get; set; }

    private AutoNext.Plotform.App.Backoffice.Models.Core.Location LocationModel { get; set; } = new();
    private EditContext? editContext;

    private bool IsEditMode => LocationModel.Id != null && LocationModel.Id != Guid.Empty;

    protected override void OnInitialized()
    {
        InitializeModel();
        editContext = new EditContext(LocationModel);
    }

    protected override void OnParametersSet()
    {
        InitializeModel();
        if (editContext != null)
            editContext = new EditContext(LocationModel);
    }

    private void InitializeModel()
    {
        if (LocationToEdit != null)
        {
            LocationModel = new AutoNext.Plotform.App.Backoffice.Models.Core.Location
            {
                Id = LocationToEdit.Id,
                CountryName = LocationToEdit.CountryName,
                CountryCode = LocationToEdit.CountryCode,
                StateName = LocationToEdit.StateName,
                StateCode = LocationToEdit.StateCode,
                CityName = LocationToEdit.CityName,
                District = LocationToEdit.District,
                Pincode = LocationToEdit.Pincode,
                Latitude = LocationToEdit.Latitude,
                Longitude = LocationToEdit.Longitude,
                IsActive = LocationToEdit.IsActive,
                CreatedAt = LocationToEdit.CreatedAt,
                UpdatedAt = LocationToEdit.UpdatedAt
            };
        }
        else if (LocationModel.Id == null || LocationModel.Id == Guid.Empty)
        {
            LocationModel = new AutoNext.Plotform.App.Backoffice.Models.Core.Location
            {
                Id = Guid.NewGuid(),
                IsActive = true,
                CreatedAt = DateTime.UtcNow
            };
        }
    }

    private async Task HandleValidSubmit()
    {
        LocationModel.UpdatedAt = DateTime.UtcNow;
        if (LocationModel.Id == null || LocationModel.Id == Guid.Empty)
        {
            LocationModel.Id = Guid.NewGuid();
            LocationModel.CreatedAt = DateTime.UtcNow;
        }

        await OnSave.InvokeAsync(LocationModel);
        await Close();
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        StateHasChanged();
    }

    public void Dispose()
    {
        editContext = null;
    }
}
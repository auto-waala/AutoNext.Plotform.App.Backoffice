@using Microsoft.AspNetCore.Components.Forms
@using AutoNext.Plotform.App.Backoffice.Models.Core
@using System.ComponentModel.DataAnnotations
@implements IDisposable

<div class="autonext-sidebar-overlay @(IsVisible ? "visible" : "")" @onclick="Close"></div>

<div class="autonext-sidebar @(IsVisible ? "visible" : "")">
    <EditForm Model="@ShippingOptionModel" OnValidSubmit="@HandleValidSubmit" FormName="shippingOptionForm">
        <DataAnnotationsValidator />
        <ValidationSummary class="autonext-validation-summary" />

        <!-- Header -->
        <div class="autonext-sidebar-header">
            <h5 class="autonext-sidebar-title">
                <i class="bi bi-truck me-2"></i>
                @(IsEditMode ? "Edit Shipping Option" : "Add Shipping Option")
            </h5>
            <button type="button" class="autonext-sidebar-close" @onclick="Close" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <!-- Body -->
        <div class="autonext-sidebar-body">
            <!-- Basic Information Section -->
            <div class="autonext-form-section">
                <h6 class="autonext-section-title">
                    <i class="bi bi-info-circle me-2"></i>Basic Information
                </h6>

                <!-- Shipping Option Name -->
                <div class="autonext-form-group">
                    <label for="Name">Shipping Option Name <span class="text-danger">*</span></label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text">
                                <i class="bi bi-file-text"></i>
                            </span>
                        </div>
                        <InputText id="Name" class="autonext-form-control"
                                   placeholder="Enter shipping option name"
                                   @bind-Value="ShippingOptionModel.Name" />
                    </div>
                    <ValidationMessage For="@(() => ShippingOptionModel.Name)" />
                    <small class="autonext-text-muted">e.g., Standard Shipping, Express Delivery, Same Day</small>
                </div>

                <!-- Shipping Option Code -->
                <div class="autonext-form-group">
                    <label for="Code">Shipping Code <span class="text-danger">*</span></label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text">
                                <i class="bi bi-upc-scan"></i>
                            </span>
                        </div>
                        <InputText id="Code" class="autonext-form-control"
                                   placeholder="Enter shipping code"
                                   @bind-Value="ShippingOptionModel.Code"
                                   @oninput="OnCodeInput" />
                    </div>
                    <ValidationMessage For="@(() => ShippingOptionModel.Code)" />
                    <small class="autonext-text-muted">Unique uppercase code (e.g., STD001, EXP001, SAME001)</small>
                </div>

                <!-- Provider -->
                <div class="autonext-form-group">
                    <label for="Provider">Provider</label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text">
                                <i class="bi bi-building"></i>
                            </span>
                        </div>
                        <InputText id="Provider" class="autonext-form-control"
                                   placeholder="e.g., FedEx, DHL, UPS, Internal"
                                   @bind-Value="ShippingOptionModel.Provider" />
                    </div>
                    <ValidationMessage For="@(() => ShippingOptionModel.Provider)" />
                </div>
            </div>

            <!-- Description Section -->
            <div class="autonext-form-section">
                <h6 class="autonext-section-title">
                    <i class="bi bi-card-text me-2"></i>Description
                </h6>
                <div class="autonext-form-group">
                    <label for="Description">Description</label>
                    <InputTextArea id="Description" class="autonext-form-control"
                                   rows="3"
                                   placeholder="Enter shipping option description"
                                   @bind-Value="ShippingOptionModel.Description" />
                    <ValidationMessage For="@(() => ShippingOptionModel.Description)" />
                    <small class="autonext-text-muted">Optional description for customers</small>
                </div>
            </div>

            <!-- Pricing & Timing Section -->
            <div class="autonext-form-section">
                <h6 class="autonext-section-title">
                    <i class="bi bi-currency-dollar me-2"></i>Pricing & Timing
                </h6>

                <div class="autonext-row">
                    <!-- Base Cost -->
                    <div class="autonext-form-group autonext-col-md-6">
                        <label for="BaseCost">Base Cost ($)</label>
                        <div class="autonext-input-group">
                            <div class="autonext-input-group-prepend">
                                <span class="autonext-input-group-text">$</span>
                            </div>
                            <InputNumber id="BaseCost" class="autonext-form-control"
                                         @bind-Value="ShippingOptionModel.BaseCost"
                                         step="0.01" min="0" max="100000" />
                        </div>
                        <ValidationMessage For="@(() => ShippingOptionModel.BaseCost)" />
                        <small class="autonext-text-muted">Fixed base cost per shipment</small>
                    </div>

                    <!-- Cost Per KM -->
                    <div class="autonext-form-group autonext-col-md-6">
                        <label for="CostPerKm">Cost Per KM ($)</label>
                        <div class="autonext-input-group">
                            <div class="autonext-input-group-prepend">
                                <span class="autonext-input-group-text">$ / km</span>
                            </div>
                            <InputNumber id="CostPerKm" class="autonext-form-control"
                                         @bind-Value="ShippingOptionModel.CostPerKm"
                                         step="0.01" min="0" max="1000" />
                        </div>
                        <ValidationMessage For="@(() => ShippingOptionModel.CostPerKm)" />
                        <small class="autonext-text-muted">Additional cost per kilometer</small>
                    </div>
                </div>

                <div class="autonext-row">
                    <!-- Estimated Days Min -->
                    <div class="autonext-form-group autonext-col-md-6">
                        <label for="EstimatedDaysMin">Estimated Days (Min)</label>
                        <div class="autonext-input-group">
                            <div class="autonext-input-group-prepend">
                                <span class="autonext-input-group-text">
                                    <i class="bi bi-clock"></i>
                                </span>
                            </div>
                            <InputNumber id="EstimatedDaysMin" class="autonext-form-control"
                                         @bind-Value="ShippingOptionModel.EstimatedDaysMin"
                                         min="0" max="365" />
                        </div>
                        <ValidationMessage For="@(() => ShippingOptionModel.EstimatedDaysMin)" />
                    </div>

                    <!-- Estimated Days Max -->
                    <div class="autonext-form-group autonext-col-md-6">
                        <label for="EstimatedDaysMax">Estimated Days (Max)</label>
                        <div class="autonext-input-group">
                            <div class="autonext-input-group-prepend">
                                <span class="autonext-input-group-text">
                                    <i class="bi bi-clock-history"></i>
                                </span>
                            </div>
                            <InputNumber id="EstimatedDaysMax" class="autonext-form-control"
                                         @bind-Value="ShippingOptionModel.EstimatedDaysMax"
                                         min="0" max="365" />
                        </div>
                        <ValidationMessage For="@(() => ShippingOptionModel.EstimatedDaysMax)" />
                    </div>
                </div>
            </div>

            <!-- Features Section -->
            <div class="autonext-form-section">
                <h6 class="autonext-section-title">
                    <i class="bi bi-stars me-2"></i>Features
                </h6>

                <div class="autonext-row">
                    <!-- Tracking & Insurance -->
                    <div class="autonext-form-group autonext-col-md-6">
                        <div class="autonext-form-check">
                            <InputCheckbox id="IsTrackingAvailable" class="autonext-form-check-input"
                                           @bind-Value="ShippingOptionModel.IsTrackingAvailable" />
                            <label class="autonext-form-check-label" for="IsTrackingAvailable">
                                <i class="bi @(ShippingOptionModel.IsTrackingAvailable ? "bi-geo-alt-fill text-primary" : "bi-geo-alt text-secondary") me-1"></i>
                                Tracking Available
                            </label>
                        </div>
                    </div>
                    <div class="autonext-form-group autonext-col-md-6">
                        <div class="autonext-form-check">
                            <InputCheckbox id="IsInsuranceAvailable" class="autonext-form-check-input"
                                           @bind-Value="ShippingOptionModel.IsInsuranceAvailable" />
                            <label class="autonext-form-check-label" for="IsInsuranceAvailable">
                                <i class="bi @(ShippingOptionModel.IsInsuranceAvailable ? "bi-shield-fill-check text-success" : "bi-shield text-secondary") me-1"></i>
                                Insurance Available
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Configuration Section -->
            <div class="autonext-form-section">
                <h6 class="autonext-section-title">
                    <i class="bi bi-gear me-2"></i>Configuration
                </h6>

                <!-- Applicable Vehicle Types -->
                <div class="autonext-form-group">
                    <label for="ApplicableVehicleTypes">Applicable Vehicle Types</label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text">
                                <i class="bi bi-truck"></i>
                            </span>
                        </div>
                        <InputText id="ApplicableVehicleTypes" class="autonext-form-control"
                                   placeholder="e.g., Car, Motorcycle, Truck, Bus"
                                   @bind-Value="ApplicableVehicleTypesString" />
                    </div>
                    <ValidationMessage For="@(() => ApplicableVehicleTypesString)" />
                    <small class="autonext-text-muted">Comma-separated list (leave empty for all)</small>
                </div>

                <!-- Display Order -->
                <div class="autonext-form-group">
                    <label for="DisplayOrder">Display Order</label>
                    <div class="autonext-input-group">
                        <div class="autonext-input-group-prepend">
                            <span class="autonext-input-group-text">
                                <i class="bi bi-sort-numeric-down"></i>
                            </span>
                        </div>
                        <InputNumber id="DisplayOrder" class="autonext-form-control"
                                     min="0" max="9999"
                                     @bind-Value="ShippingOptionModel.DisplayOrder" />
                    </div>
                    <ValidationMessage For="@(() => ShippingOptionModel.DisplayOrder)" />
                    <small class="autonext-text-muted">Lower numbers appear first</small>
                </div>

                <!-- Active Status -->
                <div class="autonext-form-group">
                    <div class="autonext-form-check">
                        <InputCheckbox id="IsActive" class="autonext-form-check-input"
                                       @bind-Value="ShippingOptionModel.IsActive" />
                        <label class="autonext-form-check-label" for="IsActive">
                            <i class="bi @(ShippingOptionModel.IsActive ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") me-1"></i>
                            Active Status
                        </label>
                    </div>
                    <small class="autonext-text-muted">Inactive options won't be available for selection</small>
                </div>
            </div>

            <!-- Usage Information -->
            @if (IsEditMode && ShippingOptionModel.CreatedAt.HasValue)
            {
                <div class="autonext-form-section">
                    <h6 class="autonext-section-title">
                        <i class="bi bi-clock-history me-2"></i>Usage Information
                    </h6>
                    <div class="autonext-info-grid">
                        <div class="autonext-info-item">
                            <span class="autonext-info-label">Created:</span>
                            <span class="autonext-info-value">@ShippingOptionModel.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        @if (ShippingOptionModel.UpdatedAt.HasValue)
                        {
                            <div class="autonext-info-item">
                                <span class="autonext-info-label">Last Updated:</span>
                                <span class="autonext-info-value">@ShippingOptionModel.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Footer -->
        <div class="autonext-sidebar-footer">
            <button type="button" class="btn btn-secondary me-2" @onclick="Close" disabled="@IsSubmitting">
                <i class="bi bi-x-circle me-1"></i> Cancel
            </button>
            <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="@(IsEditMode ? "bi-pencil" : "bi-save") me-1"></i>
                    <span>@(IsEditMode ? "Update Option" : "Save Option")</span>
                }
            </button>
        </div>
    </EditForm>
</div>

<style>

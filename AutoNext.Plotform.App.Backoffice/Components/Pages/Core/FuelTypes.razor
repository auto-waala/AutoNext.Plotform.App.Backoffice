@page "/fueltypes"
@inherits FuelTypesBase

<div class="container-fluid" style="padding-left: 0px; padding-right: 0px;">
    <div class="row" style="padding-left: 0px; padding-right: 0px;">
        <div class="col">
            <div class="card fuel-types-card">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex justify-content-between align-items-center py-1">
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <h5 class="mb-0">
                                <i class="bi bi-fuel-pump text-primary me-2"></i>Fuel Types
                            </h5>
                            <span class="badge bg-light text-dark ms-2">
                                <span class="text-primary fw-bold">@TotalCount</span> fuel types
                            </span>
                            @if (SelectedFuelTypes.Any())
                            {
                                <span class="badge bg-primary ms-1">@SelectedFuelTypes.Count selected</span>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (SelectedFuelTypes.Any())
                            {
                                <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1"
                                        @onclick="BulkDelete">
                                    <i class="bi bi-trash"></i>
                                    <span class="d-none d-sm-inline">Delete (@SelectedFuelTypes.Count)</span>
                                </button>
                            }
                            <button class="btn btn-sm btn-primary d-flex align-items-center gap-1"
                                    @onclick="OpenAddFuelTypeSidebar">
                                <i class="bi bi-plus-circle"></i>
                                <span class="d-none d-sm-inline">New Fuel Type</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Filter Bar -->
                <div class="card-body border-bottom bg-light">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label small text-muted">Search</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Search by name, code, or description..."
                                       @bind="SearchTerm" @bind:event="oninput" />
                                @if (!string.IsNullOrEmpty(SearchTerm))
                                {
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => { SearchTerm = string.Empty; ApplyFilters(); }">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Status</label>
                            <select class="form-select form-select-sm" @bind="ActiveFilter" @bind:event="onchange">
                                <option value="">All</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="ClearFilters">
                                <i class="bi bi-eraser"></i> Clear
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-0">
                    @if (IsLoading)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="text-muted mt-3 small">Loading fuel types...</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover fuel-types-table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px">
                                            <input type="checkbox"
                                                   checked="@AllPageSelected"
                                                   @onchange="_ => ToggleAllSelection()" />
                                        </th>
                                        <th>Fuel Type</th>
                                        <th>Code</th>
                                        <th>Description</th>
                                        <th class="text-center">Sort Order</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th style="width: 140px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (PaginatedFuelTypes.Any())
                                    {
                                        @foreach (var fuelType in PaginatedFuelTypes)
                                        {
                                            var localFuelType = fuelType;
                                            <tr>
                                                <td>
                                                    <input type="checkbox"
                                                           checked="@SelectedFuelTypes.Contains(localFuelType)"
                                                           @onchange="e => OnFuelTypeSelectionChanged(localFuelType, (bool)e.Value!)" />
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (!string.IsNullOrEmpty(localFuelType.IconUrl))
                                                        {
                                                            <img src="@localFuelType.IconUrl" alt="@localFuelType.Name"
                                                                 style="width: 32px; height: 32px; object-fit: contain;"
                                                                 onerror="this.style.display='none'" />
                                                        }
                                                        else
                                                        {
                                                            <div class="fuel-type-avatar">
                                                                <i class="bi bi-fuel-pump"></i>
                                                            </div>
                                                        }
                                                        <div>
                                                            <strong>@localFuelType.Name</strong>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <code class="small">@localFuelType.Code</code>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(localFuelType.Description))
                                                    {
                                                        <span class="text-muted small" title="@localFuelType.Description">
                                                            @(localFuelType.Description.Length > 50 ? localFuelType.Description.Substring(0, 50) + "..." : localFuelType.Description)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-secondary">@localFuelType.SortOrder</span>
                                                </td>
                                                <td>
                                                    <span class="badge @GetStatusBadgeClass(localFuelType.IsActive)">
                                                        @GetStatusText(localFuelType.IsActive)
                                                    </span>
                                                </td>
                                                <td>
                                                    @localFuelType.CreatedAt.ToString("yyyy-MM-dd")
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <button class="btn btn-outline-primary"
                                                                @onclick="() => OpenEditFuelTypeSidebar(localFuelType)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-outline-warning"
                                                                @onclick="() => ToggleStatus(localFuelType)">
                                                            <i class="bi @(localFuelType.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger"
                                                                @onclick="() => DeleteFuelType(localFuelType)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center py-5">
                                                @if (!string.IsNullOrEmpty(SearchTerm) || ActiveFilter != null)
                                                {
                                                    <div class="text-muted">
                                                        <i class="bi bi-filter-circle fs-1"></i>
                                                        <p class="mt-2">No fuel types match your filters</p>
                                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ClearFilters">
                                                            Clear Filters
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted">
                                                        <i class="bi bi-fuel-pump fs-1"></i>
                                                        <p class="mt-2">No fuel types found</p>
                                                        <button class="btn btn-sm btn-primary mt-2" @onclick="OpenAddFuelTypeSidebar">
                                                            <i class="bi bi-plus-circle"></i> Add First Fuel Type
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (TotalPages > 1)
                        {
                            <div class="pagination-container p-3 border-top">
                                <nav>
                                    <ul class="pagination justify-content-center mb-0">
                                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">
                                                Previous
                                            </button>
                                        </li>
                                        @for (int i = 1; i <= TotalPages; i++)
                                        {
                                            var pageNum = i;
                                            if (pageNum == 1 || pageNum == TotalPages || (pageNum >= CurrentPage - 2 && pageNum <= CurrentPage + 2))
                                            {
                                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                                    <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                                                </li>
                                            }
                                            else if (pageNum == CurrentPage - 3 || pageNum == CurrentPage + 3)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                        }
                                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">
                                                Next
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                </div>

                @if (!IsLoading && AllFuelTypes.Any())
                {
                    <div class="card-footer bg-white border-top">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex gap-3 flex-wrap">
                                <small class="text-muted"><span class="fw-medium">@TotalCount</span> total</small>
                                <small class="text-muted"><i class="bi bi-check-circle-fill text-success me-1"></i><span class="fw-medium">@ActiveCount</span> active</small>
                                <small class="text-muted"><i class="bi bi-x-circle-fill text-danger me-1"></i><span class="fw-medium">@InactiveCount</span> inactive</small>
                                <small class="text-muted">Showing @(((CurrentPage - 1) * ItemsPerPage) + 1) to @(Math.Min(CurrentPage * ItemsPerPage, TotalCount)) of @TotalCount entries</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <small class="text-muted">Show:</small>
                                <select class="form-select form-select-sm page-size-select" @onchange="OnPageSizeChanged">
                                    @foreach (var size in PageSizeOptions)
                                    {
                                        <option value="@size" selected="@(size == ItemsPerPage)">@size</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Sidebar Component -->
<FuelTypeSidebar @bind-IsVisible="@showSidebar" FuelTypeToEdit="@selectedFuelType" OnSave="@OnFuelTypeSave" />

<style>
    .fuel-type-avatar {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 16px;
    }
    
    .fuel-types-table tbody tr:hover {
        background-color: rgba(67, 233, 123, 0.05);
        cursor: pointer;
    }
    
    .page-size-select {
        width: auto;
        min-width: 70px;
    }
</style>
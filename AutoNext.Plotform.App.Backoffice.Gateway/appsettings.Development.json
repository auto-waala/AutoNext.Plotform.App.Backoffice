      },
      "listings-vehicles": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/Vehicles/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Vehicles/{**catch-all}" } ],

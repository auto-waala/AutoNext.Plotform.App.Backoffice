      },
      "core-vehicle-types": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/VehicleTypes/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/VehicleTypes/{**catch-all}" } ],
        "Order": 10
      },
      "core-health": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/health/core/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/health/core" } ],
        "Order": 5
      },
      "swagger-core": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/swagger/core/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/core" } ],
        "Order": 5
      },
      "blob-files": {
        "ClusterId": "blob-cluster",
        "Match": { "Path": "/api/v1/files/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/files/{**catch-all}" },
          { "RequestHeadersCopy": "true" }

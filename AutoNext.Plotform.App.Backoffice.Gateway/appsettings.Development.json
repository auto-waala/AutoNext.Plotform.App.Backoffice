      "listings-newly-arrived": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/NewlyArrived/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/NewlyArrived/{**catch-all}" } ],
        "Order": 12
      },
      "listings-health": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/health/listings/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/health/listings" } ],
        "Order": 1
      },
      "swagger-listings": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/swagger/listings/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/listings" } ],
        "Order": 1
      }
    },
    "Clusters": {
      "accesscontrol-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "RevolutionDuration": "00:02:00"
          }
        },
        "HttpClient": {
          "Timeout": "00:01:30",
          "MaxConnectionsPerServer": 100
        },
        "HttpRequest": {
          "Version": "2.0",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "Destinations": {
          "accesscontrol-dev-1": {
            "Address": "https://autonext-accesscontrole-dev.services.azurewebsites.betalen.in"
          }
        }
      },
      "core-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "RevolutionDuration": "00:02:00"
          }
        },
        "HttpClient": {
          "Timeout": "00:01:30",
          "MaxConnectionsPerServer": 100
        },
        "HttpRequest": {
          "Version": "2.0",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "Destinations": {
          "core-dev-1": {
            "Address": "https://autonext-core-dev.services.azurewebsites.betalen.in"
          },
          "core-dev-2": {
            "Address": "https://autonext-core-dev-2.services.azurewebsites.betalen.in"
          }
        }
      },
      "blob-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "RevolutionDuration": "00:02:00"
          }
        },
        "HttpClient": {
          "Timeout": "00:05:00",
          "MaxConnectionsPerServer": 50,
          "MaxResponseContentBufferSize": 104857600
        },
        "HttpRequest": {
          "Version": "2.0",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "Destinations": {
          "blob-dev-1": {
            "Address": "https://autonext-blob-dev.services.azurewebsites.betalen.in"
          }
        }
      },
      "listings-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "RevolutionDuration": "00:02:00"
          }
        },
        "HttpClient": {
          "Timeout": "00:01:30",
          "MaxConnectionsPerServer": 100
        },
        "HttpRequest": {
          "Version": "2.0",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "Destinations": {
          "listings-dev-1": {
            "Address": "https://autonext-listings-dev.services.azurewebsites.betalen.in"
          }
        }

      "listings-used-vehicles": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/UsedVehicles/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/UsedVehicles/{**catch-all}" } ],
        "Order": 8
      },
      "listings-premium-vehicle-base": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/PremiumVehicle" },
        "Transforms": [ { "PathPattern": "/api/v{version}/PremiumVehicle" } ],
        "Order": 9
      },
      "listings-premium-vehicle": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/PremiumVehicle/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/PremiumVehicle/{**catch-all}" } ],
        "Order": 10

        "Order": 10
      },
      "blob-health": {
        "ClusterId": "blob-cluster",
        "Match": { "Path": "/health/blob/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/health/blob" } ],
        "Order": 5
      },
      "swagger-blob": {
        "ClusterId": "blob-cluster",
        "Match": { "Path": "/swagger/blob/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/blob" } ],
        "Order": 5
      },
      "listings-featured-vehicles-base": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/FeaturedVehicle" },
        "Transforms": [ { "PathPattern": "/api/v{version}/FeaturedVehicle" } ],
        "Order": 1
      },
      "listings-featured-vehicles": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/FeaturedVehicle/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/FeaturedVehicle/{**catch-all}" } ],

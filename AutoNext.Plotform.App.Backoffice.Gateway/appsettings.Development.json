{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp.ReverseProxy": "Information",
      "AutoNext.Plotform.App.Backoffice.Gateway": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "accesscontrol-auth": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/api/v{version}/Auth/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Auth/{**catch-all}" } ],
        "Order": 10
      },
      "accesscontrol-organizations": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/api/v{version}/Organizations/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Organizations/{**catch-all}" } ],
        "Order": 10
      },
      "accesscontrol-permissions": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/api/v{version}/Permissions/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Permissions/{**catch-all}" } ],
        "Order": 10
      },
      "accesscontrol-roles": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/api/v{version}/Roles/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Roles/{**catch-all}" } ],
        "Order": 10
      },
      "accesscontrol-users": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/api/v{version}/Users/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Users/{**catch-all}" } ],
        "Order": 10
      },
      "accesscontrol-health": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/health/accesscontrol/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/health/accesscontrol" } ],
        "Order": 5
      },
      "swagger-accesscontrol": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/swagger/accesscontrol/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/accesscontrol" } ],
        "Order": 5
      },
      "core-brands": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/Brands/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Brands/{**catch-all}" } ],
        "Order": 10
      },
      "core-categories": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/Categories/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Categories/{**catch-all}" } ],
        "Order": 10
      },
      "core-colors": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/Colors/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Colors/{**catch-all}" } ],

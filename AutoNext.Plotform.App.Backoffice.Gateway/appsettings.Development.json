        "Transforms": [ { "PathPattern": "/api/v{version}/DocumentTypes/{**catch-all}" } ],
        "Order": 10
      },
      "core-features": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/features/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/features/{**catch-all}" } ],
        "Order": 10
      },
      "core-fuel-types": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/FuelTypes/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/FuelTypes/{**catch-all}" } ],
        "Order": 10

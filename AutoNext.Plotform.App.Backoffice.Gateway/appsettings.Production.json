{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "accesscontrol-auth": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/api/v{version}/Auth/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Auth/{**catch-all}" } ]
      },
      "accesscontrol-organizations": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/api/v{version}/Organizations/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Organizations/{**catch-all}" } ]
      },
      "accesscontrol-permissions": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/api/v{version}/Permissions/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Permissions/{**catch-all}" } ]
      },
      "accesscontrol-roles": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/api/v{version}/Roles/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Roles/{**catch-all}" } ]
      },
      "accesscontrol-users": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/api/v{version}/Users/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Users/{**catch-all}" } ]
      },
      "accesscontrol-health": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/health/accesscontrol/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/health/accesscontrol" } ]
      },
      "swagger-accesscontrol": {
        "ClusterId": "accesscontrol-cluster",
        "Match": { "Path": "/swagger/accesscontrol/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/accesscontrol" } ]
      },

      "core-brands": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/Brands/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Brands/{**catch-all}" } ]
      },
      "core-categories": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/Categories/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Categories/{**catch-all}" } ]
      },
      "core-colors": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/Colors/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Colors/{**catch-all}" } ]
      },
      "core-document-types": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/DocumentTypes/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/DocumentTypes/{**catch-all}" } ]
      },
      "core-features": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/features/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/features/{**catch-all}" } ]
      },
      "core-fuel-types": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/FuelTypes/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/FuelTypes/{**catch-all}" } ]
      },
      "core-locations": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/Locations/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Locations/{**catch-all}" } ]
      },
      "core-transmissions": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/Transmissions/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Transmissions/{**catch-all}" } ]
      },
      "core-vehicle-types": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/api/v{version}/VehicleTypes/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/VehicleTypes/{**catch-all}" } ]
      },
      "core-health": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/health/core/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/health/core" } ]
      },
      "swagger-core": {
        "ClusterId": "core-cluster",
        "Match": { "Path": "/swagger/core/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/core" } ]
      },

      "blob-files": {
        "ClusterId": "blob-cluster",
        "Match": { "Path": "/api/v1/files/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/files/{**catch-all}" },
          { "RequestHeadersCopy": "true" }
        ]
      },
      "blob-health": {
        "ClusterId": "blob-cluster",
        "Match": { "Path": "/health/blob/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/health/blob" } ]
      },
      "swagger-blob": {
        "ClusterId": "blob-cluster",
        "Match": { "Path": "/swagger/blob/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/blob" } ]
      },

      "listings-vehicles": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/Vehicles/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Vehicles/{**catch-all}" } ]
      },
      "listings-vehicles-base": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/Vehicles" },
        "Transforms": [ { "PathPattern": "/api/v{version}/Vehicles" } ]
      },
      "listings-used-vehicles": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/UsedVehicles/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/UsedVehicles/{**catch-all}" } ]
      },
      "listings-used-vehicles-base": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/UsedVehicles" },
        "Transforms": [ { "PathPattern": "/api/v{version}/UsedVehicles" } ]
      },
      "listings-newly-arrived": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/NewlyArrived/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/NewlyArrived/{**catch-all}" } ]
      },
      "listings-newly-arrived-base": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/NewlyArrived" },
        "Transforms": [ { "PathPattern": "/api/v{version}/NewlyArrived" } ]
      },
      "listings-featured-vehicles": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/FeaturedVehicle/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v{version}/FeaturedVehicle/{**catch-all}" } ]
      },
      "listings-featured-vehicles-base": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/api/v{version}/FeaturedVehicle" },
        "Transforms": [ { "PathPattern": "/api/v{version}/FeaturedVehicle" } ]
      },
      "listings-health": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/health/listings/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/health/listings" } ]
      },
      "swagger-listings": {
        "ClusterId": "listings-cluster",
        "Match": { "Path": "/swagger/listings/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/listings" } ]
      }
    },
    "Clusters": {
      "accesscontrol-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "RevolutionDuration": "00:02:00"
          }
        },
        "HttpClient": {
          "Timeout": "00:01:30",
          "MaxConnectionsPerServer": 100
        },
        "Destinations": {
          "accesscontrol-prod-1": {
            "Address": "https://autonext-accesscontrole-prod.services.azurewebsites.betalen.in"
          }
        }
      },
      "core-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "RevolutionDuration": "00:02:00"
          }
        },
        "HttpClient": {
          "Timeout": "00:01:30",
          "MaxConnectionsPerServer": 100
        },
        "Destinations": {
          "core-prod-1": {
            "Address": "https://autonext-core-prod.services.azurewebsites.betalen.in"
          },
          "core-prod-2": {
            "Address": "https://autonext-core-prod-2.services.azurewebsites.betalen.in"
          }
        }
      },
      "blob-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "RevolutionDuration": "00:02:00"
          }
        },
        "HttpClient": {
          "Timeout": "00:05:00",
          "MaxConnectionsPerServer": 50,
          "MaxResponseContentBufferSize": 104857600
        },
        "Destinations": {
          "blob-prod-1": {
            "Address": "https://autonext-blob.services.azurewebsites.betalen.in"
          }
        }
      },
      "listings-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "RevolutionDuration": "00:02:00"
          }
        },
        "HttpClient": {
          "Timeout": "00:01:30",
          "MaxConnectionsPerServer": 100
        },
        "Destinations": {
          "listings-prod-1": {
            "Address": "https://autonext-listings-prod.services.azurewebsites.betalen.in"
          }
        }
      }
    }
  }
}